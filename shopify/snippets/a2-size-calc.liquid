</div>

<script>
  /* ================================================================
     A2 Bikes – Size Calculator v2
     ----------------------------------------------------------------
     • No inline handlers (Shopify / CSP safe)
     • Multi-instance safe (works when Shopify duplicates content
       for desktop/mobile layouts — no ID collisions)
     • Out-of-range messaging for < 5'3" and > 6'5"
     • Borderline heights recommend sizing up
     • Inseam-aware: unusual inseam + borderline = stronger size-up
     • Scrolls result into view on mobile after calculation
     ================================================================ */
  function a2SizeCalcInit() {
    'use strict';

    /* ── SIZE CHART CONFIG ──
       Sizes share the same height ranges across SP and Rogue, but the
       traditional cm labels differ slightly per bike. Advanced/aero SP
       riders can opt to size down via the SP-only checkbox.
       min/max = inclusive height range in inches.
       cm     = traditional geometry-based label shown next to the letter size. */
    const SP_CHART = [
      { min: 63, max: 66, size: 'S',  cm: 50 },
      { min: 67, max: 70, size: 'M',  cm: 53 },
      { min: 71, max: 74, size: 'L',  cm: 55 },
      { min: 75, max: 77, size: 'XL', cm: 58 }
    ];

    const ROGUE_CHART = [
      { min: 63, max: 66, size: 'S',  cm: 50 },
      { min: 67, max: 70, size: 'M',  cm: 52 },
      { min: 71, max: 74, size: 'L',  cm: 54 },
      { min: 75, max: 77, size: 'XL', cm: 58 }
    ];

    const MIN_HEIGHT = 63;
    const MAX_HEIGHT = 77;

    /* Builds per bike — listed price-descending so premium leads.
       Add/remove builds here when the lineup changes. */
    const BIKE_BUILDS = {
      sp: [
        { name: 'SRAM Red AXS',   url: '/collections/sp/products/sp-sram-red-axs' },
        { name: 'SRAM Force AXS', url: '/collections/sp/products/sp-sram-force' },
        { name: 'SRAM Rival AXS', url: '/collections/sp/products/sp-sram-rival-1' },
        { name: 'Shimano 105',    url: '/collections/sp/products/sp-shimano-105n' }
      ],
      rogue: [
        { name: 'SRAM Red AXS',   url: '/collections/rogue/products/rogue-sram-red-axs' },
        { name: 'SRAM Force AXS', url: '/collections/rogue/products/rogue-sram-force-etap-axs' },
        { name: 'SRAM Rival AXS', url: '/collections/rogue/products/rogue-rival-axs' },
        { name: 'Shimano 105',    url: '/collections/rogue/products/rogue-shimano-105' }
      ]
    };

    const AVG_INSEAM = {
      63:29.5, 64:30, 65:30.5, 66:31, 67:31.5,
      68:32, 69:32.5, 70:33, 71:33.5, 72:34,
      73:34.5, 74:35, 75:35.5, 76:36, 77:36.5
    };
    const INSEAM_TOLERANCE = 1.5;

    /* ── SHARED HELPERS ── */
    function fmtHeight(totalIn) {
      return Math.floor(totalIn / 12) + '′' + (totalIn % 12) + '″';
    }

    function lookupSize(chart, h) {
      for (let i = 0; i < chart.length; i++) {
        if (h >= chart[i].min && h <= chart[i].max) {
          return { index: i, size: chart[i].size };
        }
      }
      return null;
    }

    function isBorderline(chart, h) {
      for (let i = 0; i < chart.length - 1; i++) {
        if (h === chart[i].max) return true;
      }
      return false;
    }

    function nextSizeUp(chart, idx) {
      if (idx < chart.length - 1) return chart[idx + 1].size;
      return null;
    }

    function nextSizeDown(chart, idx) {
      if (idx > 0) return chart[idx - 1].size;
      return null;
    }

    /* Defers to Shopify's Customer Privacy API when present. If the visitor
       has opted out of marketing/analytics tracking, we suppress Klaviyo
       calls. When the API isn't available we assume tracking is allowed
       (consistent with prior behavior on stores without a consent banner). */
    function hasMarketingConsent() {
      try {
        if (window.Shopify && window.Shopify.customerPrivacy) {
          const cp = window.Shopify.customerPrivacy;
          if (typeof cp.userCanBeTracked === 'function') {
            return !!cp.userCanBeTracked();
          }
          if (typeof cp.analyticsProcessingAllowed === 'function') {
            return !!cp.analyticsProcessingAllowed();
          }
        }
      } catch (e) { /* fall through to permissive default */ }
      return true;
    }

    /* Only log tracking errors on dev hosts so production shoppers don't see
       noise, but issues are visible during local/staging QA. */
    function isDevHost() {
      try {
        const h = window.location.hostname || '';
        return h === 'localhost' || h === '127.0.0.1' || h.endsWith('.local') ||
               h.indexOf('staging') !== -1 || h.indexOf('preview') !== -1;
      } catch (e) { return false; }
    }
    function devWarn(label, err) {
      if (isDevHost() && window.console && console.warn) {
        console.warn('[a2-size-calc] ' + label, err);
      }
    }

    function trackKlaviyo(eventName, props) {
      if (!hasMarketingConsent()) return;
      try {
        if (window.klaviyo && typeof window.klaviyo.track === 'function') {
          window.klaviyo.track(eventName, props);
          return;
        }
        if (window._learnq && typeof window._learnq.push === 'function') {
          window._learnq.push(['track', eventName, props]);
          return;
        }
        devWarn('No Klaviyo client found for event: ' + eventName);
      } catch (e) {
        devWarn('trackKlaviyo failed for event: ' + eventName, e);
      }
    }

    function identifyKlaviyo(email, props) {
      if (!hasMarketingConsent()) return false;
      try {
        const payload = { '$email': email };
        for (const k in props) {
          if (Object.prototype.hasOwnProperty.call(props, k) && props[k] != null) {
            payload[k] = props[k];
          }
        }
        if (window.klaviyo && typeof window.klaviyo.identify === 'function') {
          window.klaviyo.identify(payload);
          return true;
        }
        if (window._learnq && typeof window._learnq.push === 'function') {
          window._learnq.push(['identify', payload]);
          return true;
        }
        devWarn('No Klaviyo client found for identify');
      } catch (e) {
        devWarn('identifyKlaviyo failed', e);
      }
      return false;
    }

    function isValidEmail(s) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);
    }

    /* ── INIT EACH INSTANCE ──
       Shopify themes often duplicate Custom Liquid blocks into
       separate desktop and mobile containers. This loop ensures
       every copy of the calculator gets its own event binding
       scoped to its own container. */
    const containers = document.querySelectorAll('.js-a2-size-calc');

    for (let c = 0; c < containers.length; c++) {
      (function (root) {
        if (root.dataset.a2Bound) return;
        root.dataset.a2Bound = '1';
        /* Scoped element refs — all queries stay inside this root */
        function q(sel) { return root.querySelector('[data-a2="' + sel + '"]'); }

        const formEl       = q('form');
        const modelEl      = q('bike-model');
        const feetEl       = q('height-feet');
        const inchesEl     = q('height-inches');
        const inseamEl     = q('inseam');
        const aeroEl       = q('aero');
        const aeroGroup    = q('aero-group');
        const btnEl        = q('calc-btn');
        const placeholder  = q('placeholder');
        const errorEl      = q('error');
        const resultBox    = q('result-content');
        const sizeVal      = q('size-value');
        const modelNote    = q('model-note');
        const fitNote      = q('fit-note');
        const ctasEl       = q('ctas');
        const oorBox       = q('oor-box');
        const oorHeading   = q('oor-heading');
        const oorMsg       = q('oor-msg');
        const oorForm      = q('oor-form');
        const oorName      = q('oor-name');
        const oorEmail     = q('oor-email');
        const oorSubmit    = q('oor-submit');
        const oorError     = q('oor-error');
        const oorSuccess   = q('oor-success');
        const resultsPanel = q('results-panel');

        if (!btnEl) return;

        function updateAeroVisibility() {
          if (!aeroGroup) return;
          if (modelEl.value === 'sp') {
            aeroGroup.classList.add('is-visible');
          } else {
            aeroGroup.classList.remove('is-visible');
            if (aeroEl) aeroEl.checked = false;
          }
        }

        function hideAll() {
          placeholder.style.display = 'none';
          errorEl.classList.remove('is-visible');
          resultBox.classList.remove('is-visible');
          oorBox.classList.remove('is-visible');
        }

        function showError(msg) {
          hideAll();
          errorEl.textContent = msg;
          errorEl.classList.add('is-visible');
        }

        function showAnimated(el) {
          el.classList.remove('is-visible');
          void el.offsetWidth;
          el.classList.add('is-visible');
        }

        function scrollToResults() {
          /* Mobile: smooth-scroll the results into view */
          if (window.innerWidth <= 600) {
            setTimeout(function () {
              resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 80);
            return;
          }
          /* Desktop: shift focus to the results region so keyboard + SR users
             land on the new content. tabindex=-1 makes it programmatically
             focusable without entering the tab order. */
          if (resultsPanel) {
            resultsPanel.setAttribute('tabindex', '-1');
            try {
              resultsPanel.focus({ preventScroll: true });
            } catch (e) {
              resultsPanel.focus();
            }
          }
        }

        function calculate() {
          const feet   = parseInt(feetEl.value, 10);
          const inches = parseInt(inchesEl.value, 10);

          if (isNaN(feet) || isNaN(inches)) {
            showError('Please select your height above.');
            return;
          }

          const totalIn  = feet * 12 + inches;
          const bike     = modelEl.value;
          const chart    = bike === 'sp' ? SP_CHART : ROGUE_CHART;
          const bikeName = bike === 'sp' ? 'The SP' : 'The Rogue';

          hideAll();

          if (totalIn < MIN_HEIGHT || totalIn > MAX_HEIGHT) {
            const isShort   = totalIn < MIN_HEIGHT;
            const rangeText = isShort ? '5′3″ and taller' : 'up to 6′5″';
            oorHeading.textContent = 'We’d Love to Help You Find the Right Fit';
            oorMsg.textContent =
              'Our current ' + bikeName + ' lineup is designed for riders ' + rangeText + '. ' +
              'At ' + fmtHeight(totalIn) + ', we want to make sure you get a bike that fits safely and performs beautifully. ' +
              'Drop your details below and we’ll personally help you explore your options.';

            /* Stash context so the lead-form submit handler can include it */
            if (oorForm) {
              oorForm.dataset.bike       = bikeName;
              oorForm.dataset.height     = fmtHeight(totalIn);
              oorForm.dataset.heightIn   = String(totalIn);
              oorForm.dataset.resultType = isShort ? 'too_short' : 'too_tall';

              /* Reset form state in case the user re-runs after a prior OOR submit */
              if (oorSuccess) oorSuccess.classList.remove('is-visible');
              if (oorError)   oorError.classList.remove('is-visible');
              oorForm.style.display = '';
              if (oorName)   { oorName.disabled = false;   oorName.value = ''; }
              if (oorEmail)  { oorEmail.disabled = false;  oorEmail.value = ''; }
              if (oorSubmit) { oorSubmit.disabled = false; }
            }

            showAnimated(oorBox);
            scrollToResults();
            trackKlaviyo('Size Calculator', {
              bike_model: bikeName, height: fmtHeight(totalIn), height_inches: totalIn,
              recommended_size: 'Out of Range', result_type: isShort ? 'too_short' : 'too_tall',
              tags: ['SizeCalculator', 'OutOfRange']
            });
            return;
          }

          const match = lookupSize(chart, totalIn);
          if (!match) {
            showError('Something went wrong — please try again.');
            return;
          }

          const size      = match.size;
          const sizeCm    = chart[match.index].cm;
          const border    = isBorderline(chart, totalIn);
          const upSize    = nextSizeUp(chart, match.index);
          const upCm      = upSize   ? chart[match.index + 1].cm : null;
          const downSize  = nextSizeDown(chart, match.index);
          const downCm    = downSize ? chart[match.index - 1].cm : null;
          const inseam    = parseInt(inseamEl.value, 10);
          const hasInseam = !isNaN(inseam);
          const aeroPref  = !!(aeroEl && aeroEl.checked && bike === 'sp');

          const avgIns       = AVG_INSEAM[totalIn] || 32;
          const inseamDelta  = hasInseam ? inseam - avgIns : 0;
          const inseamLong   = hasInseam && inseamDelta > INSEAM_TOLERANCE;
          const inseamShort  = hasInseam && inseamDelta < -INSEAM_TOLERANCE;
          const inseamNormal = hasInseam && !inseamLong && !inseamShort;

          /* Helper: format a single size as "M (53 cm)" */
          function lbl(letter, cm) { return letter + ' (' + cm + ' cm)'; }

          let sizeText = lbl(size, sizeCm);
          let noteText = bikeName + ' in size ' + lbl(size, sizeCm) + ' — built for riders around ' + fmtHeight(totalIn) + '.';
          let fitText  = '';

          if (aeroPref && border && upSize) {
            /* SP + aero rider on a size boundary — suppress the size-up bias */
            sizeText = lbl(size, sizeCm);
            fitText  = 'You’re at the top of the ' + size + ' range. For a more aggressive aero position on the SP, we recommend staying with ' + lbl(size, sizeCm) +
                       ' rather than sizing up.';
            if (downSize) {
              fitText += ' Experienced triathletes prioritizing maximum aero may even consider sizing down to ' + lbl(downSize, downCm) +
                         ' — but get a professional bike fit first to confirm it’s right for you.';
            }
          } else if (aeroPref && !border) {
            /* SP + aero, comfortably in a size — note size-down option */
            if (downSize) {
              fitText = lbl(size, sizeCm) + ' is the standard recommendation for your height. Experienced triathletes seeking the most aggressive aero position may consider sizing down to ' + lbl(downSize, downCm) +
                        '. A professional bike fit is recommended before sizing down.';
            } else {
              fitText = 'You’re already in our smallest SP frame — ideal for an aero, aggressive position.';
            }
          } else if (border && upSize) {
            if (inseamLong) {
              sizeText = size + ' / ' + upSize + ' (' + sizeCm + ' / ' + upCm + ' cm)';
              noteText = bikeName + ' in size ' + lbl(size, sizeCm) + ' or ' + lbl(upSize, upCm) + ' for ' + fmtHeight(totalIn) + '.';
              fitText  = 'You’re right at the boundary between ' + size + ' and ' + upSize +
                         ', and your inseam is longer than average for your height. We strongly recommend sizing up to ' +
                         lbl(upSize, upCm) + ' for a more comfortable ride with better leg extension.';
            } else if (inseamShort) {
              fitText = 'You’re at the top of the ' + size + ' range, but your inseam is shorter than average for your height. ' +
                        'Staying with ' + lbl(size, sizeCm) + ' should give you the best fit and standover clearance.';
            } else {
              sizeText = size + ' / ' + upSize + ' (' + sizeCm + ' / ' + upCm + ' cm)';
              noteText = bikeName + ' in size ' + lbl(size, sizeCm) + ' or ' + lbl(upSize, upCm) + ' for ' + fmtHeight(totalIn) + '.';
              fitText  = 'Your height puts you right on the border between ' + size + ' and ' + upSize +
                         '. We recommend sizing up to ' + lbl(upSize, upCm) + ' for a more comfortable ride.';
              if (!hasInseam) {
                fitText += ' For an even more precise recommendation, try adding your inseam measurement above.';
              }
            }
          } else {
            if (inseamLong && upSize) {
              fitText = 'Your inseam is longer than average for your height. You may want to consider sizing up to ' + lbl(upSize, upCm) +
                        ' for extra leg extension and a more comfortable ride. Otherwise, ' + lbl(size, sizeCm) + ' with seatpost adjustment will work well.';
            } else if (inseamLong && !upSize) {
              /* XL with a long inseam — no size to step up to */
              fitText = 'You’re already in our largest frame and your inseam is longer than average for your height. ' +
                        'A longer or high-rise seatpost will get you the leg extension you need — reach out to us if you’d like personalized fit guidance.';
            } else if (inseamShort) {
              fitText = 'Your inseam is a bit shorter than average for your height — ' + lbl(size, sizeCm) +
                        ' is the right call. Our full adjustability system will dial in your fit perfectly.';
            } else if (inseamNormal) {
              fitText = 'Your inseam is right in the sweet spot for this size. You’re good to go.';
            } else {
              fitText = 'For an even more precise fit, try adding your inseam measurement above and re-run. ' +
                        'Every A2 bike ships with our full adjustability system, so you’ll dial it in perfectly.';
            }
          }

          sizeVal.textContent   = sizeText;
          modelNote.textContent = noteText;
          fitNote.textContent   = fitText;

          if (ctasEl) {
            /* Wipe any prior build buttons (the user may have changed bikes) */
            while (ctasEl.firstChild) ctasEl.removeChild(ctasEl.firstChild);

            const builds = BIKE_BUILDS[bike] || [];
            if (builds.length) {
              const heading = document.createElement('div');
              heading.className = 'a2-size-calc__ctas-heading';
              heading.textContent = 'Shop ' + bikeName + ' — size ' + lbl(size, sizeCm);
              ctasEl.appendChild(heading);

              builds.forEach(function (build) {
                const a = document.createElement('a');
                a.className = 'a2-size-calc__cta';
                a.href = build.url;
                a.textContent = 'Shop ' + build.name + ' →';
                a.setAttribute('aria-label', 'Shop ' + bikeName + ' ' + build.name + ' in size ' + lbl(size, sizeCm));
                ctasEl.appendChild(a);
              });
            }
          }

          showAnimated(resultBox);
          scrollToResults();

          const klavProps = {
            bike_model: bikeName, height: fmtHeight(totalIn), height_inches: totalIn,
            recommended_size: size, size_cm: sizeCm,
            displayed_size: sizeText, is_borderline: border,
            aero_preference: aeroPref,
            tags: ['SizeCalculator', size]
          };
          if (hasInseam) {
            klavProps.inseam = inseam;
            klavProps.inseam_vs_average = inseamLong ? 'long' : (inseamShort ? 'short' : 'normal');
          }
          if (border && upSize && !aeroPref) {
            klavProps.size_up_suggestion = upSize;
          }
          if (aeroPref && downSize) {
            klavProps.size_down_option = downSize;
          }
          trackKlaviyo('Size Calculator', klavProps);
        }

        if (formEl) {
          formEl.addEventListener('submit', function (e) {
            e.preventDefault();
            calculate();
          });
        } else {
          btnEl.addEventListener('click', function (e) {
            e.preventDefault();
            calculate();
          });
        }

        if (modelEl) {
          modelEl.addEventListener('change', updateAeroVisibility);
          updateAeroVisibility();
        }

        if (oorForm) {
          oorForm.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!oorEmail || !oorName) return;

            const name  = (oorName.value || '').trim();
            const email = (oorEmail.value || '').trim();

            if (!isValidEmail(email)) {
              if (oorError) {
                oorError.textContent = 'Please enter a valid email address.';
                oorError.classList.add('is-visible');
              }
              oorEmail.focus();
              return;
            }
            if (oorError) oorError.classList.remove('is-visible');

            const leadProps = {
              first_name:    name,
              bike_interest: oorForm.dataset.bike || '',
              height:        oorForm.dataset.height || '',
              height_inches: parseInt(oorForm.dataset.heightIn, 10) || null,
              oor_type:      oorForm.dataset.resultType || '',
              source:        'Size Calculator (Out of Range)'
            };

            identifyKlaviyo(email, leadProps);
            trackKlaviyo('Size Calculator OOR Lead', {
              email:         email,
              first_name:    name,
              bike_model:    leadProps.bike_interest,
              height:        leadProps.height,
              height_inches: leadProps.height_inches,
              result_type:   leadProps.oor_type,
              tags: ['SizeCalculator', 'OutOfRange', 'Lead']
            });

            /* Disable form + show success */
            if (oorName)   oorName.disabled = true;
            if (oorEmail)  oorEmail.disabled = true;
            if (oorSubmit) oorSubmit.disabled = true;
            oorForm.style.display = 'none';
            if (oorSuccess) oorSuccess.classList.add('is-visible');
          });
        }

      })(containers[c]);
    }
  }

  /* Run immediately if DOM is ready, otherwise wait */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', a2SizeCalcInit);
  } else {
    a2SizeCalcInit();
  }
</script>
