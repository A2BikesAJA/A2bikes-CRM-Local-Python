  {%- when 'bars' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18M3 12h18M3 17h18"/><path d="M8 4l-2 16M16 4l2 16"/></svg>
  {%- when 'sliders' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10M4 12h7M4 18h12"/><circle cx="18" cy="6" r="2.2"/><circle cx="15" cy="12" r="2.2"/><circle cx="20" cy="18" r="2.2"/></svg>
  {%- when 'warranty' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 8v5M12 16h.01"/></svg>
  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M9 12l2 2 4-4"/></svg>
