{%- comment -%}
  A2 Bikes — Rogue Fit Calculator (road fit).
  Geometry source: "Rogue All-Road Geometry Guide" (page 152362090660) +
  rider-height bands from the canonical /pages/size-guide table.
  Height + inseam -> frame size (A2's published bands, inseam tiebreak at
  borders per the size-guide rule), saddle-height starting point (0.883 x
  inseam, LeMond method, labeled as a starting point), and the stock cockpit
  facts for the recommended size. Pushes `rogue_fit_result` to the dataLayer.
{%- endcomment -%}

{% raw %}
<style>
  .a2-rfc { margin-top: 8px; }
  .a2-rfc h3 { font-family: var(--a2-font-display); margin: 0 0 .4em; }
  .a2-rfc__row { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; }
  .a2-rfc__row > label:first-child, .a2-rfc__label { width: 90px; flex: 0 0 auto; }
  .a2-rfc input { width: 110px; padding: .55em .7em; border-radius: 9px; border: 1px solid var(--a2-border); background: var(--a2-bg); color: var(--a2-fg); font-size: 1rem; }
  .a2-rfc input.a2-rfc--short { width: 70px; }
  .a2-rfc input:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-rfc__units { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 0 14px; }
  .a2-rfc__units-title { font-weight: 700; }
  .a2-rfc__opt { cursor: pointer; }
  .a2-rfc__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .a2-rfc__opt span { display: inline-block; padding: .5em 1.1em; border: 2px solid var(--a2-border); border-radius: 999px; line-height: 1.2; white-space: nowrap; transition: border-color .12s ease, background .12s ease; }
  .a2-rfc__opt input:checked + span { border-color: var(--a2-accent); background: var(--a2-accent); color: var(--a2-accent-fg); font-weight: 700; }
  .a2-rfc__opt input:focus-visible + span { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-rfc__btn { background: var(--a2-accent); color: var(--a2-accent-fg); font-family: var(--a2-font-display); text-transform: uppercase; letter-spacing: .04em; padding: .8em 1.4em; border: 2px solid var(--a2-accent); border-radius: 999px; cursor: pointer; transition: filter .12s ease; }
  .a2-rfc__btn:hover { filter: brightness(1.06); }
  .a2-rfc__btn:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-rfc__results { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 1.5em; }
  .a2-rfc__card { flex: 1 1 260px; max-width: 420px; border: 1px solid var(--a2-border); border-radius: 12px; padding: 18px; }
  .a2-rfc__card.is-best { border-color: var(--a2-accent); }
  .a2-rfc__card h4 { font-family: var(--a2-font-display); margin: 0 0 4px; font-size: 1.2rem; }
  .a2-rfc__badge { display: inline-block; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; color: var(--a2-accent); border: 1px solid currentColor; border-radius: 999px; padding: .25em .8em; margin-bottom: 8px; }
  .a2-rfc__card table { width: 100%; border-collapse: collapse; font-size: .92rem; margin-top: 8px; }
  .a2-rfc__card td { padding: 4px 0; border-bottom: 1px solid var(--a2-border); }
  .a2-rfc__card td:last-child { text-align: right; font-weight: 600; }
  .a2-rfc__note { font-size: .85rem; opacity: .75; margin-top: 10px; }
  .a2-rfc__msg { margin-top: 14px; }
</style>

<div class="a2-rfc" id="a2-rogue-fit">
  <h3>Rogue Fit Calculator</h3>
  <div class="a2-rfc__units" role="radiogroup" aria-label="Units">
    <span class="a2-rfc__units-title">Units:</span>
    <label class="a2-rfc__opt"><input type="radio" name="a2rfcUnits" value="in" checked onchange="a2rfcUnits()"><span>inches</span></label>
    <label class="a2-rfc__opt"><input type="radio" name="a2rfcUnits" value="cm" onchange="a2rfcUnits()"><span>cm</span></label>
  </div>
  <div class="a2-rfc__row" id="a2rfcHeightImperial">
    <label for="a2rfc_h_ft">Height</label>
    <input type="number" step="1" inputmode="numeric" id="a2rfc_h_ft" class="a2-rfc--short" placeholder="5"> <span>ft</span>
    <input type="number" step="any" inputmode="decimal" id="a2rfc_h_in" class="a2-rfc--short" placeholder="10"> <span>in</span>
  </div>
  <div class="a2-rfc__row" id="a2rfcHeightMetric" style="display:none;">
    <label for="a2rfc_h_cm">Height</label>
    <input type="number" step="any" inputmode="decimal" id="a2rfc_h_cm" placeholder="178"> <span>cm</span>
  </div>
  <div class="a2-rfc__row">
    <label for="a2rfc_inseam">Inseam</label>
    <input type="number" step="any" inputmode="decimal" id="a2rfc_inseam" placeholder="32"> <span class="a2rfcUnit">in</span>
  </div>
  <button type="button" class="a2-rfc__btn" onclick="a2rfcFind()">Find my Rogue size</button>
  <div class="a2-rfc__msg" id="a2rfc_msg"></div>
  <div class="a2-rfc__results" id="a2rfc_results"></div>
  <p class="a2-rfc__note">Saddle height is a starting point (0.883 &times; inseam, bottom bracket to saddle top) — fine-tune on your first rides. Between sizes? A longer-than-average inseam points to the larger frame. Free size exchanges either way.</p>
</div>

<script>
if (!window.__a2rfcInit) {
  window.__a2rfcInit = true;

  // Rogue geometry (mm) — source: Rogue All-Road Geometry Guide + size-guide bands.
  var A2_ROGUE_GEO = [
    { size: "Small",  st: 462, ett: 528, stack: 521, reach: 378, stem: 90,  crank: 165,   hMin: 1600, hMax: 1675 },
    { size: "Medium", st: 482, ett: 540, stack: 535, reach: 381, stem: 90,  crank: 170,   hMin: 1700, hMax: 1780 },
    { size: "Large",  st: 510, ett: 552, stack: 550, reach: 386, stem: 100, crank: 172.5, hMin: 1800, hMax: 1880 },
    { size: "XL",     st: 528, ett: 567, stack: 567, reach: 390, stem: 110, crank: 175,   hMin: 1900, hMax: 1960 }
  ];

  function a2rfcUnits() {
    var el = document.querySelector('input[name="a2rfcUnits"]:checked');
    var isIn = !el || el.value === "in";
    document.getElementById("a2rfcHeightImperial").style.display = isIn ? "flex" : "none";
    document.getElementById("a2rfcHeightMetric").style.display = isIn ? "none" : "flex";
    document.querySelectorAll(".a2rfcUnit").forEach(function (u) { u.textContent = isIn ? "in" : "cm"; });
    document.getElementById("a2rfc_inseam").placeholder = isIn ? "32" : "81";
  }

  function a2rfcCard(g, best, label, saddle) {
    var saddleIn = Math.round(saddle / 25.4 * 10) / 10;
    return '<div class="a2-rfc__card' + (best ? ' is-best' : '') + '">' +
      '<span class="a2-rfc__badge">' + label + '</span>' +
      '<h4>Rogue &mdash; ' + g.size + '</h4>' +
      '<table>' +
      '<tr><td>Saddle height (starting point)</td><td>' + Math.round(saddle) + ' mm / ' + saddleIn + '"</td></tr>' +
      '<tr><td>Effective top tube</td><td>' + g.ett + ' mm</td></tr>' +
      '<tr><td>Stack / Reach</td><td>' + g.stack + ' / ' + g.reach + ' mm</td></tr>' +
      '<tr><td>Stock stem</td><td>' + g.stem + ' mm</td></tr>' +
      '<tr><td>Stock crank</td><td>' + g.crank + ' mm</td></tr>' +
      '</table></div>';
  }

  function a2rfcFind() {
    var msg = document.getElementById("a2rfc_msg"), res = document.getElementById("a2rfc_results");
    msg.textContent = ""; res.innerHTML = "";
    var el = document.querySelector('input[name="a2rfcUnits"]:checked');
    var isIn = !el || el.value === "in";
    var height, inseamRaw = parseFloat(document.getElementById("a2rfc_inseam").value);
    if (isIn) {
      var ft = parseFloat(document.getElementById("a2rfc_h_ft").value);
      var inch = parseFloat(document.getElementById("a2rfc_h_in").value);
      if (isNaN(ft) && isNaN(inch)) { msg.textContent = "Please enter your height (feet and inches)."; return; }
      height = ((isNaN(ft) ? 0 : ft) * 12 + (isNaN(inch) ? 0 : inch)) * 25.4;
    } else {
      var cm = parseFloat(document.getElementById("a2rfc_h_cm").value);
      if (isNaN(cm)) { msg.textContent = "Please enter your height in centimeters."; return; }
      height = cm * 10;
    }
    if (isNaN(inseamRaw)) { msg.textContent = "Please enter your inseam."; return; }
    var inseam = inseamRaw * (isIn ? 25.4 : 10);
    if (height < 1200 || height > 2200 || inseam < 500 || inseam > 1200 || inseam >= height) {
      msg.textContent = "Those numbers look off — double-check your height and inseam (" + (isIn ? "in inches" : "in centimeters") + ").";
      return;
    }
    if (height < 1575) {
      msg.innerHTML = "You're at the small end of the Rogue's range &mdash; <a href=\"/pages/contact-a2-bikes\">talk to our fit team</a> and we'll find a setup that works.";
      return;
    }
    if (height > 1985) {
      msg.innerHTML = "You're at the tall end of the Rogue's range &mdash; <a href=\"/pages/contact-a2-bikes\">talk to our fit team</a> and we'll find a setup that works.";
      return;
    }

    // distance from each size's published height band (0 = inside the band)
    var scored = A2_ROGUE_GEO.map(function (g) {
      var d = 0;
      if (height < g.hMin) d = g.hMin - height;
      else if (height > g.hMax) d = height - g.hMax;
      return { g: g, d: d };
    }).sort(function (a, b) { return a.d - b.d; });

    var best = scored[0], second = scored[1];
    // borderline: outside every band (between bands) or within 20mm of an edge
    var borderline = best.d > 0 ||
      (height - best.g.hMin < 20) || (best.g.hMax - height < 20);

    // inseam tiebreak per the size-guide rule: long legs for your height -> larger size
    if (borderline && second) {
      var legRatio = inseam / height; // ~0.47 average
      var pair = [best, second].sort(function (a, b) { return a.g.stack - b.g.stack; }); // smaller, larger
      best = legRatio >= 0.47 ? pair[1] : pair[0];
      second = legRatio >= 0.47 ? pair[0] : pair[1];
    }

    var saddle = 0.883 * inseam;
    var html = a2rfcCard(best.g, true, "Recommended", saddle);
    if (borderline && second) { html += a2rfcCard(second.g, false, "Also worth considering", saddle); }
    res.innerHTML = html;
    if (borderline && second) {
      msg.textContent = "You're near the border of two sizes. We sized you by your leg length; if you prefer a sportier (smaller) or more relaxed (larger) fit, the other size works too.";
    }
    if (window.a2dl) { window.a2dl("rogue_fit_result", { recommended_frame: best.g.size }); }
    window.dataLayer = window.dataLayer || [];
  }

  window.a2rfcUnits = a2rfcUnits;
  window.a2rfcFind = a2rfcFind;
}
</script>
{% endraw %}
