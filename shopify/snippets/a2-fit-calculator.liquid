{%- comment -%}
  A2 Bikes — Fit Finder (bike size calculator)
  ----------------------------------------------------------------------------
  Lifted from A2's existing Fit Finder (the canonical /pages/speed-phreak-fit-
  calculator + the Speed Phreak PDP build). The FIT MATH IS UNCHANGED — same
  fit_coords, same height/inseam -> Pad X/Y model, same nearest-combination
  search. Only the presentation was adapted: scoped + responsive styles using
  the landing-page theme tokens, and Chart.js is lazy-loaded on first result so
  it never weighs down initial page load.

  Geometry updated June 2026 from the official A2 SP fit sheets (V0.01):
  "Metron Alloy" (Shimano 105 / Rival builds) and "Si013" (Force / Red builds).
  Envelopes extracted from the sheet vector/raster charts; sizes S-XL; three
  A2 SP stems (78/93/108mm); 0-70mm riser stack in 5mm steps; pad fore/aft
  ±16mm (Metron clip-ons) or ±64mm (Si013 rails).
{%- endcomment -%}

{% raw %}
<style>
  .a2-fit-calc { margin-top: 8px; }
  .a2-fit-calc .fitCalcButton {
    background: var(--a2-accent); color: var(--a2-accent-fg);
    font-family: var(--a2-font-display); text-transform: uppercase; letter-spacing: .04em;
    padding: .8em 1.4em; border: 2px solid var(--a2-accent); border-radius: 999px;
    cursor: pointer; transition: filter .12s ease;
  }
  .a2-fit-calc .fitCalcButton:hover { filter: brightness(1.06); }
  .a2-fit-calc .fitCalcButton:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc .fitCalc__div_fitKnown_buttons .fitCalcButton[aria-pressed="false"] { background: transparent; color: var(--a2-fg); border-color: var(--a2-border); }
  .a2-fit-calc h3 { font-family: var(--a2-font-display); margin: 0 0 .4em; }
  .a2-fit-calc__intro { margin-bottom: 1em; }
  .a2-fit-calc .fitCalc__div_fitKnown_buttons { display: flex; flex-wrap: wrap; gap: 14px; margin: 1em 0; }
  .a2-fit-calc .fitCalc__forms { display: flex; flex-wrap: wrap; gap: 24px; }
  .a2-fit-calc .fitCalc__form_pads,
  .a2-fit-calc .fitCalc__form_body { display: flex; flex-direction: column; gap: 12px; }
  .a2-fit-calc .fitCalc__row { display: flex; align-items: center; gap: 10px; }
  .a2-fit-calc label { width: 120px; }
  .a2-fit-calc input {
    width: 120px; padding: .55em .7em; border-radius: 9px;
    border: 1px solid var(--a2-border); background: var(--a2-bg); color: var(--a2-fg); font-size: 1rem;
  }
  .a2-fit-calc input:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc .fitCalc__div_fit_options { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 1.5em; }
  .a2-fit-calc .fitCalc__div_fitOption { flex: 1 1 220px; border: 1px solid var(--a2-border); border-radius: 12px; padding: 16px; }
  .a2-fit-calc .fitCalc__div_fitOption:empty,
  .a2-fit-calc .fitCalc__div_fitOption:has(> p:empty) { display: none; }
  .a2-fit-calc .a2fc-build { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 0 14px; }
  .a2-fit-calc .a2fc-build__title { font-weight: 700; margin-right: 2px; }
  .a2-fit-calc label.a2fc-build__opt { width: auto; cursor: pointer; }
  .a2-fit-calc .a2fc-build__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .a2-fit-calc .a2fc-build__opt span { display: inline-block; padding: .5em 1.1em; border: 2px solid var(--a2-border); border-radius: 999px; line-height: 1.2; white-space: nowrap; transition: border-color .12s ease, background .12s ease; }
  .a2-fit-calc .a2fc-build__opt input:checked + span { border-color: var(--a2-accent); background: var(--a2-accent); color: var(--a2-accent-fg); font-weight: 700; }
  .a2-fit-calc .a2fc-build__opt input:focus-visible + span { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc #padyxdisplaybox { margin-top: 1em; }
  .a2-fit-calc .a2fc-chart-container { position: relative; width: 100%; max-width: 880px; margin-top: 1.5em; }
  .a2-fit-calc canvas { max-width: 100%; }
  @media (max-width: 600px) { .a2-fit-calc label { width: 90px; } }
</style>

<div class="a2-fit-calc" id="a2-fit-calc">
  <div id="togglefit" style="display:block;">
    <button class="fitCalcButton" type="button" onclick="toggleFit()">Find my size</button>
  </div>

  <div id="fitfinder" style="display:none;">
    <h3>Fit Finder</h3>
    <div id="fitPath" style="display:block;">
      <div class="a2fc-build" role="radiogroup" aria-label="Your build">
        <span class="a2fc-build__title">Your build:</span>
        <label class="a2fc-build__opt"><input type="radio" name="a2fcBuild" value="metron" checked><span>Shimano 105 / Rival</span></label>
        <label class="a2fc-build__opt"><input type="radio" name="a2fcBuild" value="si013"><span>Force / Red</span></label>
      </div>
      <p class="a2-fit-calc__intro">Do you already know your Pad X / Y?</p>
      <div class="fitCalc__div_fitKnown_buttons">
        <button class="fitCalcButton" type="button" onclick="beginFit(false)">No — use my measurements</button>
        <button class="fitCalcButton" type="button" onclick="beginFit(true)">Yes — I know Pad X/Y</button>
      </div>
    </div>

    <div class="fitCalc__forms">
      <div id="enterPadXY" style="display:none;">
        <form class="fitCalc__form_pads" onsubmit="return false;">
          <div class="fitCalc__row"><label for="pady">Pad Y</label><input type="number" inputmode="numeric" id="pady"> mm</div>
          <div class="fitCalc__row"><label for="padx">Pad Center X</label><input type="number" inputmode="numeric" id="padx"> mm</div>
          <button class="fitCalcButton" type="button" onclick="buttonPress(true)">Find fit</button>
        </form>
      </div>
      <div id="enterMeasurements" style="display:none;">
        <form class="fitCalc__form_body" onsubmit="return false;">
          <div class="a2fc-build" role="radiogroup" aria-label="Units">
            <span class="a2fc-build__title">Units:</span>
            <label class="a2fc-build__opt"><input type="radio" name="a2fcUnits" value="in" checked onchange="a2fcUnitsChanged()"><span>inches</span></label>
            <label class="a2fc-build__opt"><input type="radio" name="a2fcUnits" value="cm" onchange="a2fcUnitsChanged()"><span>cm</span></label>
          </div>
          <div class="fitCalc__row"><label for="fitCalc__input_height">Height</label><input type="number" step="any" inputmode="decimal" id="fitCalc__input_height" placeholder="70"> <span class="a2fcUnit">in</span></div>
          <div class="fitCalc__row"><label for="fitCalc__input_inseam">Inseam</label><input type="number" step="any" inputmode="decimal" id="fitCalc__input_inseam" placeholder="32"> <span class="a2fcUnit">in</span></div>
          <button class="fitCalcButton" type="button" onclick="buttonPress(false)">Find fit</button>
        </form>
      </div>
      <div id="padyxdisplaybox"></div>
    </div>

    <div class="fitCalc__div_fit_options">
      <div class="fitCalc__div_fitOption" id="op1div"><p id="op1p"></p></div>
      <div class="fitCalc__div_fitOption"><p id="op2p"></p></div>
      <div class="fitCalc__div_fitOption"><p id="op3p"></p></div>
    </div>

    <div id="chart"><div class="a2fc-chart-container"><canvas id="myChart"></canvas></div></div>
  </div>
</div>

<script>
if (!window.__a2fcInit) {
  window.__a2fcInit = true;

  // Lazy-load Chart.js only when a result is first computed (keeps the LP light).
  function a2fcEnsureChart(cb) {
    if (window.Chart) { cb(); return; }
    if (window.__a2fcChartCbs) { window.__a2fcChartCbs.push(cb); return; }
    window.__a2fcChartCbs = [cb];
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.6.0/Chart.min.js';
    s.async = true;
    s.onload = function () { (window.__a2fcChartCbs || []).forEach(function (f) { f(); }); window.__a2fcChartCbs = []; };
    document.head.appendChild(s);
  }

  function buttonPress(fitKnown) {
    var fit;
    if (fitKnown == true) {
      if (document.getElementById("padx").value == "" || document.getElementById("pady").value == "") {
        document.getElementById("op1p").innerHTML = "Please enter your pad X/Y.";
        return;
      } else if (/\D/.test(document.getElementById("padx").value) || /\D/.test(document.getElementById("pady").value)) {
        document.getElementById("op1p").innerHTML = "Please only enter whole numbers for pad X/Y.";
        return;
      }
      fit = {
        userpadx: Number(document.getElementById("padx").value),
        userpady: Number(document.getElementById("pady").value)
      };
    } else if (fitKnown == false) {
      var unitEl = document.querySelector('input[name="a2fcUnits"]:checked');
      var unit = unitEl ? unitEl.value : "in";
      var hRaw = parseFloat(document.getElementById("fitCalc__input_height").value),
          iRaw = parseFloat(document.getElementById("fitCalc__input_inseam").value);
      if (isNaN(hRaw) || isNaN(iRaw)) {
        document.getElementById("op1p").innerHTML = "Please enter your height and inseam.";
        return;
      }
      var factor = unit === "in" ? 25.4 : 10;
      var height = hRaw * factor, inseam = iRaw * factor;
      if (height < 1200 || height > 2200 || inseam < 500 || inseam > 1200 || inseam >= height) {
        document.getElementById("op1p").innerHTML = "Those numbers look off — double-check your height and inseam (" + (unit === "in" ? "in inches" : "in centimeters") + ").";
        return;
      }
      var saddle = 0.9 * inseam;
      fit = {
        userpadx: 0.29 * height + (0.42 - saddle / height) * 500,
        userpady: 0.35 * height - (0.42 - saddle / height) * 400
      };
    }

    fit_array = buildFitArray(a2fcConfigKey());
    fit = findCombinations(fit.userpadx, fit.userpady, fit_array);

    document.getElementById("op1p").innerHTML = "<h3>Option 1</h3>" + stringCombination(fit.options[0]);
    document.getElementById("op2p").innerHTML = "<h3>Option 2</h3>" + stringCombination(fit.options[1]);
    document.getElementById("op3p").innerHTML = "<h3>Option 3</h3>" + stringCombination(fit.options[2]);
    document.getElementById("padyxdisplaybox").innerHTML =
      "<h4>Pad Y: " + String(Math.round(fit.userpady)) + "mm<br>Pad Center X: " + String(Math.round(fit.userpadx)) + "mm</h4>";

    if (window.a2dl) { window.a2dl("fit_calculator_result", { recommended_frame: fit.options[0].frame }); }
  }

  function beginFit(fitKnown) {
    document.getElementById("enterPadXY").style.display = fitKnown ? "block" : "none";
    document.getElementById("enterMeasurements").style.display = fitKnown ? "none" : "block";
    var btns = document.querySelectorAll(".fitCalc__div_fitKnown_buttons .fitCalcButton");
    if (btns.length === 2) {
      btns[0].setAttribute("aria-pressed", fitKnown ? "false" : "true");
      btns[1].setAttribute("aria-pressed", fitKnown ? "true" : "false");
    }
  }

  function toggleFit() { showMe("togglefit"); showMe("fitfinder"); }

  function a2fcUnitsChanged() {
    var unitEl = document.querySelector('input[name="a2fcUnits"]:checked');
    var isIn = !unitEl || unitEl.value === "in";
    document.querySelectorAll(".a2fcUnit").forEach(function (el) { el.textContent = isIn ? "in" : "cm"; });
    document.getElementById("fitCalc__input_height").placeholder = isIn ? "70" : "178";
    document.getElementById("fitCalc__input_inseam").placeholder = isIn ? "32" : "81";
  }

  function showMe(showBox) {
    var el = document.getElementById(showBox);
    el.style.display = (el.style.display == "block") ? "none" : "block";
  }

  function showChart(fit) {
    a2fcEnsureChart(function () {
      var colors = { frame_s: "#5b5be0", frame_m: "#e8527e", frame_l: "#f29a3c", frame_xl: "#cbe23c" };
      var fit_points = { S: [], M: [], L: [], XL: [] };
      for (var i = fit_array.length - 1; i >= 0; i--) {
        if (fit_points[fit_array[i].frame]) { fit_points[fit_array[i].frame].push({ x: fit_array[i].padx, y: fit_array[i].pady }); }
      }
      var ctx = document.getElementById("myChart").getContext("2d");
      new Chart(ctx, {
        type: "scatter",
        data: { datasets: [
          { pointRadius: 6, pointBackgroundColor: "#111", backgroundColor: "#111", label: "Your fit point", showLine: false, data: [{ x: fit.userpadx, y: fit.userpady }] },
          { pointRadius: 5, pointBackgroundColor: "blue", backgroundColor: "blue", label: "Option 1", showLine: false, data: [{ x: fit.options[0].padx, y: fit.options[0].pady }] },
          { pointRadius: 5, pointBackgroundColor: "orange", backgroundColor: "orange", label: "Option 2", showLine: false, data: [{ x: fit.options[1].padx, y: fit.options[1].pady }] },
          { pointRadius: 5, pointBackgroundColor: "red", backgroundColor: "red", label: "Option 3", showLine: false, data: [{ x: fit.options[2].padx, y: fit.options[2].pady }] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_s, backgroundColor: colors.frame_s, label: "Size S", showLine: false, data: fit_points["S"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_m, backgroundColor: colors.frame_m, label: "Size M", showLine: false, data: fit_points["M"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_l, backgroundColor: colors.frame_l, label: "Size L", showLine: false, data: fit_points["L"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_xl, backgroundColor: colors.frame_xl, label: "Size XL", showLine: false, data: fit_points["XL"] }
        ]},
        options: {
          legend: { display: true, position: "right" },
          title: { display: true, text: "Fit Point Plot" },
          scales: {
            xAxes: [{ type: "linear", position: "bottom", scaleLabel: { display: true, labelString: "Pad Center X [mm]" } }],
            yAxes: [{ scaleLabel: { display: true, labelString: "Pad Y [mm]" } }]
          },
          tooltips: { callbacks: { label: function (t, d) { var l = String(d.datasets[t.datasetIndex].label); return l + ": (" + t.xLabel + ", " + t.yLabel + ")"; } } }
        }
      });
    });
  }

  // --- Fit geometry (A2 SP fit sheets V0.01, June 2026) ----------------------
  // Bases = pad position at rail center, shortest stem, zero risers.
  var fit_configs = {
    metron: {
      label: "Shimano 105 / SRAM Rival — Vision Metron Alloy clip-ons",
      sizes: { S: [450.1, 552.4], M: [473.0, 585.8], L: [495.0, 619.8], XL: [517.1, 653.7] },
      stems: [[0, 0, "A2 SP 78mm"], [14.4, 3.2, "A2 SP 93mm"], [28.9, 6.3, "A2 SP 108mm"]],
      pads: [-16, -8, 0, 8, 16]
    },
    si013: {
      label: "SRAM Force / Red — Vision Si013",
      sizes: { S: [535.5, 579.0], M: [558.5, 612.2], L: [581.2, 645.8], XL: [603.0, 679.1] },
      stems: [[0, 0, "A2 SP 78mm"], [12.1, 3.0, "A2 SP 93mm"], [24.2, 5.9, "A2 SP 108mm"]],
      pads: [-64, -48, -32, -16, 0, 16, 32, 48, 64]
    }
  };
  var spacer_steps = [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70];
  var frame_key = ["S", "M", "L", "XL"];
  var fit_array = [];

  function a2fcConfigKey() {
    var el = document.querySelector('input[name="a2fcBuild"]:checked');
    return el ? el.value : "metron";
  }

  function buildFitArray(cfgKey) {
    var cfg = fit_configs[cfgKey], arr = [];
    for (var i = 0; i < frame_key.length; i++) {
      for (var j = 0; j < cfg.stems.length; j++) {
        for (var k = 0; k < spacer_steps.length; k++) {
          for (var m = 0; m < cfg.pads.length; m++) {
            arr.push({
              frame: frame_key[i],
              stem: cfg.stems[j][2],
              pedSpacers: spacer_steps[k],
              pad: cfg.pads[m],
              padx: Math.round(cfg.sizes[frame_key[i]][0] + cfg.stems[j][0] + cfg.pads[m]),
              pady: Math.round(cfg.sizes[frame_key[i]][1] + cfg.stems[j][1] + spacer_steps[k])
            });
          }
        }
      }
    }
    return arr;
  }

  function findCombinations(padx, pady, fit_data) {
    var combinations = fit_data;
    var fit = { userpady: pady, userpadx: padx };
    for (var i = combinations.length - 1; i >= 0; i--) {
      combinations[i].error = ((combinations[i].padx - fit.userpadx) ** 2 + (combinations[i].pady - fit.userpady) ** 2) ** 0.5;
    }
    fit.options = [combinations[0], combinations[1], combinations[2]];
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].error < fit.options[0].error) { fit.options[0] = combinations[i]; }
    }
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].error < fit.options[1].error && combinations[i].frame != fit.options[0].frame) { fit.options[1] = combinations[i]; }
    }
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].error < fit.options[2].error && combinations[i].frame != fit.options[0].frame && combinations[i].frame != fit.options[1].frame) { fit.options[2] = combinations[i]; }
    }
    fit.options.sort(function (a, b) { return a.pedSpacers - b.pedSpacers; });
    fit.options[0].description = "Least pedestal spacer stack option.";
    fit.options[1].description = "Most room for adjustment.";
    fit.options[2].description = "Largest pedestal spacer stack option.";
    fit.options.sort(function (a, b) { return a.error - b.error; });
    fit.userpadx = Math.round(fit.userpadx * 10) / 10;
    fit.userpady = Math.round(fit.userpady * 10) / 10;
    showChart(fit);
    return fit;
  }

  function stringCombination(combination) {
    return "<b>Pad Y:</b> " + String(combination.pady) + "mm <br><b>Pad Center X:</b> " + String(combination.padx) +
      "mm <br><b>Frame:</b> " + String(combination.frame) + " <br><b>Stem:</b> " + String(combination.stem) +
      " <br><b>Pedestal spacers:</b> " + String(combination.pedSpacers) + "mm<br><b>Pad position:</b> " + String(combination.pad) +
      "<br><b>Distance from desired point:</b> " + String(Math.round(combination.error)) + "mm<br>";
  }
}
</script>
{% endraw %}
