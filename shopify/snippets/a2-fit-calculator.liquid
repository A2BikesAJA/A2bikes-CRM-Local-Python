{%- comment -%}
  A2 Bikes — Fit Finder (bike size calculator)
  ----------------------------------------------------------------------------
  Lifted from A2's existing Fit Finder (the canonical /pages/speed-phreak-fit-
  calculator + the Speed Phreak PDP build). The FIT MATH IS UNCHANGED — same
  fit_coords, same height/inseam -> Pad X/Y model, same nearest-combination
  search. Only the presentation was adapted: scoped + responsive styles using
  the landing-page theme tokens, and Chart.js is lazy-loaded on first result so
  it never weighs down initial page load.

  Geometry updated June 2026 from the official A2 SP fit sheets (V0.01):
  "Metron Alloy" (Shimano 105 / Rival builds) and "Si013" (Force / Red builds).
  Envelopes extracted from the sheet vector/raster charts; sizes S-XL; three
  A2 SP stems (78/93/108mm); 0-70mm riser stack in 5mm steps; pad fore/aft
  ±16mm (Metron clip-ons) or ±64mm (Si013 rails).

  Fix June 2026: the height/inseam path now gates the recommended frame to
  the rider's height band (same S-XL ranges as the PDP Size Calculator), and
  the search is scored by fit error PLUS an "edge" penalty. Pad X/Y alone can
  be reached by a small frame slammed to the limit of its stem/spacer/pad
  range (especially the wide-range Si013 cockpit), which previously let a
  6'2" rider be recommended a Small. The gate fixes the frame; Pad X/Y then
  dials in the stem/spacer/pad WITHIN it.
{%- endcomment -%}

{% raw %}
<style>
  .a2-fit-calc { margin-top: 8px; }
  .a2-fit-calc .fitCalcButton {
    background: var(--a2-accent); color: var(--a2-accent-fg);
    font-family: var(--a2-font-display); text-transform: uppercase; letter-spacing: .04em;
    padding: .8em 1.4em; border: 2px solid var(--a2-accent); border-radius: 999px;
    cursor: pointer; transition: filter .12s ease;
  }
  .a2-fit-calc .fitCalcButton:hover { filter: brightness(1.06); }
  .a2-fit-calc .fitCalcButton:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc .fitCalc__div_fitKnown_buttons .fitCalcButton[aria-pressed="false"] { background: transparent; color: var(--a2-fg); border-color: var(--a2-border); }
  .a2-fit-calc h3 { font-family: var(--a2-font-display); margin: 0 0 .4em; }
  .a2-fit-calc__intro { margin-bottom: 1em; }
  .a2-fit-calc .fitCalc__div_fitKnown_buttons { display: flex; flex-wrap: wrap; gap: 14px; margin: 1em 0; }
  .a2-fit-calc .fitCalc__forms { display: flex; flex-wrap: wrap; gap: 24px; }
  .a2-fit-calc .fitCalc__form_pads,
  .a2-fit-calc .fitCalc__form_body { display: flex; flex-direction: column; gap: 12px; }
  .a2-fit-calc .fitCalc__row { display: flex; align-items: center; gap: 10px; }
  .a2-fit-calc label { width: 120px; }
  .a2-fit-calc input {
    width: 120px; padding: .55em .7em; border-radius: 9px;
    border: 1px solid var(--a2-border); background: var(--a2-bg); color: var(--a2-fg); font-size: 1rem;
  }
  .a2-fit-calc input:focus-visible { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc input.a2fc-short { width: 70px; }
  .a2-fit-calc .fitCalc__div_fit_options { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 1.5em; }
  .a2-fit-calc .fitCalc__div_fitOption { flex: 1 1 220px; border: 1px solid var(--a2-border); border-radius: 12px; padding: 16px; }
  .a2-fit-calc .fitCalc__div_fitOption:empty,
  .a2-fit-calc .fitCalc__div_fitOption:has(> p:empty) { display: none; }
  .a2-fit-calc .a2fc-build { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 0 0 14px; }
  .a2-fit-calc .a2fc-build__title { font-weight: 700; margin-right: 2px; }
  .a2-fit-calc label.a2fc-build__opt { width: auto; cursor: pointer; }
  .a2-fit-calc .a2fc-build__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .a2-fit-calc .a2fc-build__opt span { display: inline-block; padding: .5em 1.1em; border: 2px solid var(--a2-border); border-radius: 999px; line-height: 1.2; white-space: nowrap; transition: border-color .12s ease, background .12s ease; }
  .a2-fit-calc .a2fc-build__opt input:checked + span { border-color: var(--a2-accent); background: var(--a2-accent); color: var(--a2-accent-fg); font-weight: 700; }
  .a2-fit-calc .a2fc-build__opt input:focus-visible + span { outline: 3px solid var(--a2-accent-2); outline-offset: 2px; }
  .a2-fit-calc #padyxdisplaybox { margin-top: 1em; }
  .a2-fit-calc__explain { margin: 0 0 1.2em; max-width: 70ch; font-size: .95rem; line-height: 1.5; opacity: .9; }
  .a2-fit-calc details.a2fc-how { margin: 0 0 1.1em; border: 1px solid var(--a2-border); border-radius: 10px; }
  .a2-fit-calc .a2fc-how__sum { cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 11px 13px; font-size: .9rem; color: var(--a2-fg); }
  .a2-fit-calc .a2fc-how__sum::-webkit-details-marker { display: none; }
  .a2-fit-calc .a2fc-how__sum::after { content: ""; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); opacity: .55; transition: transform .15s ease; }
  .a2-fit-calc details[open] .a2fc-how__sum::after { transform: rotate(-135deg); }
  .a2-fit-calc details.a2fc-how .a2-fit-calc__explain { margin: 0; padding: 0 13px 13px; max-width: none; }
  .a2-fit-calc__drop { margin-top: .8em; padding: 12px 14px; border: 1px solid var(--a2-border); border-left: 3px solid var(--a2-accent); border-radius: 10px; font-size: .92rem; line-height: 1.45; }
  .a2-fit-calc__drop span { display: block; margin-top: 6px; font-size: .85rem; opacity: .8; }
  .a2-fit-calc .a2fc-why { margin: .2em 0 .8em; font-size: .93rem; line-height: 1.55; }
  .a2-fit-calc .a2fc-why--exch { opacity: .72; font-size: .85rem; }
  .a2-fit-calc .a2fc-setup { font-size: .9rem; line-height: 1.55; padding-top: 8px; border-top: 1px solid var(--a2-border); opacity: .9; }
  .a2-fit-calc__div_fitOption h3 { margin: 0 0 .5em; }
  .a2-fit-calc .a2fc-start { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 18px 20px; border: 2px solid var(--a2-accent); border-radius: 14px; background: var(--a2-bg); background: color-mix(in srgb, var(--a2-accent) 7%, var(--a2-bg)); }
  .a2-fit-calc .a2fc-start__ico svg { width: 34px; height: 34px; stroke: var(--a2-accent); fill: none; stroke-width: 1.7; display: block; }
  .a2-fit-calc .a2fc-start__copy { display: flex; flex-direction: column; gap: 2px; flex: 1 1 220px; }
  .a2-fit-calc .a2fc-start__copy b { font-family: var(--a2-font-display); font-size: 1.18rem; line-height: 1.1; }
  .a2-fit-calc .a2fc-start__copy span { font-size: .88rem; opacity: .8; line-height: 1.4; }
  .a2-fit-calc .a2fc-start__btn { flex: 0 0 auto; }
  .a2-fit-calc .a2fc-chart-container { position: relative; width: 100%; max-width: 880px; margin-top: 1.5em; }
  .a2-fit-calc canvas { max-width: 100%; }
  @media (max-width: 600px) {
    .a2-fit-calc label { width: 84px; }
    .a2-fit-calc h3 { font-size: 1.05rem; }
    .a2-fit-calc__explain { font-size: .88rem; line-height: 1.45; }
    .a2-fit-calc .a2fc-how__sum { font-size: .85rem; padding: 10px 12px; }
    .a2-fit-calc__intro { font-size: .9rem; margin-bottom: .7em; }
    .a2-fit-calc .a2fc-start { padding: 13px 14px; gap: 12px; }
    .a2-fit-calc .a2fc-start__copy b { font-size: 1.05rem; }
    .a2-fit-calc .a2fc-start__copy span { font-size: .85rem; }
    .a2-fit-calc .a2fc-start__btn { flex: 1 1 100%; }
    .a2-fit-calc .fitCalc__div_fitKnown_buttons { gap: 10px; margin: .8em 0; }
    .a2-fit-calc .fitCalc__div_fitKnown_buttons .fitCalcButton { flex: 1 1 100%; }
    .a2-fit-calc .fitCalcButton { padding: .7em 1.1em; }
    .a2-fit-calc .fitCalc__forms { gap: 16px; }
    .a2-fit-calc .fitCalc__div_fit_options { gap: 12px; margin-top: 1.1em; }
    .a2-fit-calc .fitCalc__div_fitOption { flex-basis: 100%; padding: 13px; }
    .a2-fit-calc .a2fc-why { font-size: .88rem; line-height: 1.45; }
    .a2-fit-calc .a2fc-setup { font-size: .85rem; }
    .a2-fit-calc__drop { padding: 11px 12px; font-size: .88rem; }
  }
</style>

<div class="a2-fit-calc" id="a2-fit-calc">
  <div id="togglefit" style="display:block;">
    <div class="a2fc-start">
      <span class="a2fc-start__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="7" width="19" height="10" rx="2"/><path d="M6.5 7v3M10 7v4M13.5 7v3M17 7v4"/></svg></span>
      <div class="a2fc-start__copy">
        <b>Find your size</b>
        <span>Answer two quick measurements &mdash; we&rsquo;ll recommend your exact frame size and explain why.</span>
      </div>
      <button class="fitCalcButton a2fc-start__btn" type="button" onclick="toggleFit()">Find my size</button>
    </div>
  </div>

  <div id="fitfinder" style="display:none;">
    <h3>Fit Finder</h3>
    <details class="a2fc-how"><summary class="a2fc-how__sum">How fitting works</summary>
    <p class="a2-fit-calc__explain">This finds your aerobar <b>Pad X / Y</b> — where your forearms rest relative to the bottom bracket — then matches the frame, stem, spacers, and pad position that put you there. The number that sets how the bike <em>feels</em> is the <b>drop</b>: the height from the top of your saddle down to the top of the elbow pads. <b>More drop</b> is faster and more aero but a more aggressive position to hold; <b>less drop</b> (or pads level with / above the saddle) is more comfortable, trading a little aerodynamics. We aim for a balanced starting point — go to a smaller frame or fewer spacers for more drop, a larger frame or more spacers for less.</p></details>
    <div id="fitPath" style="display:block;">
      <div class="a2fc-build" role="radiogroup" aria-label="Your build">
        <span class="a2fc-build__title">Your build:</span>
        <label class="a2fc-build__opt"><input type="radio" name="a2fcBuild" value="metron" checked><span>Shimano 105 / Rival</span></label>
        <label class="a2fc-build__opt"><input type="radio" name="a2fcBuild" value="si013"><span>Force / Red</span></label>
      </div>
      <p class="a2-fit-calc__intro">Do you already know your Pad X / Y?</p>
      <div class="fitCalc__div_fitKnown_buttons">
        <button class="fitCalcButton" type="button" onclick="beginFit(false)">No — use my measurements</button>
        <button class="fitCalcButton" type="button" onclick="beginFit(true)">Yes — I know Pad X/Y</button>
      </div>
    </div>

    <div class="fitCalc__forms">
      <div id="enterPadXY" style="display:none;">
        <form class="fitCalc__form_pads" onsubmit="return false;">
          <div class="fitCalc__row"><label for="pady">Pad Y</label><input type="number" inputmode="numeric" id="pady"> mm</div>
          <div class="fitCalc__row"><label for="padx">Pad Center X</label><input type="number" inputmode="numeric" id="padx"> mm</div>
          <button class="fitCalcButton" type="button" onclick="buttonPress(true)">Find fit</button>
        </form>
      </div>
      <div id="enterMeasurements" style="display:none;">
        <form class="fitCalc__form_body" onsubmit="return false;">
          <div class="a2fc-build" role="radiogroup" aria-label="Units">
            <span class="a2fc-build__title">Units:</span>
            <label class="a2fc-build__opt"><input type="radio" name="a2fcUnits" value="in" checked onchange="a2fcUnitsChanged()"><span>inches</span></label>
            <label class="a2fc-build__opt"><input type="radio" name="a2fcUnits" value="cm" onchange="a2fcUnitsChanged()"><span>cm</span></label>
          </div>
          <div class="fitCalc__row" id="a2fcHeightImperial">
            <label for="fitCalc__input_height_ft">Height</label>
            <input type="number" step="1" inputmode="numeric" id="fitCalc__input_height_ft" class="a2fc-short" placeholder="5"> <span>ft</span>
            <input type="number" step="any" inputmode="decimal" id="fitCalc__input_height_in" class="a2fc-short" placeholder="10"> <span>in</span>
          </div>
          <div class="fitCalc__row" id="a2fcHeightMetric" style="display:none;">
            <label for="fitCalc__input_height">Height</label>
            <input type="number" step="any" inputmode="decimal" id="fitCalc__input_height" placeholder="178"> <span>cm</span>
          </div>
          <div class="fitCalc__row"><label for="fitCalc__input_inseam">Inseam</label><input type="number" step="any" inputmode="decimal" id="fitCalc__input_inseam" placeholder="32"> <span class="a2fcUnit">in</span></div>
          <button class="fitCalcButton" type="button" onclick="buttonPress(false)">Find fit</button>
        </form>
      </div>
      <div id="padyxdisplaybox"></div>
    </div>

    <div class="fitCalc__div_fit_options">
      <div class="fitCalc__div_fitOption" id="op1div"><p id="op1p"></p></div>
      <div class="fitCalc__div_fitOption"><p id="op2p"></p></div>
      <div class="fitCalc__div_fitOption"><p id="op3p"></p></div>
    </div>

    <div id="chart"><div class="a2fc-chart-container"><canvas id="myChart"></canvas></div></div>
  </div>
</div>

<script>
if (!window.__a2fcInit) {
  window.__a2fcInit = true;

  // Lazy-load Chart.js only when a result is first computed (keeps the LP light).
  function a2fcEnsureChart(cb) {
    if (window.Chart) { cb(); return; }
    if (window.__a2fcChartCbs) { window.__a2fcChartCbs.push(cb); return; }
    window.__a2fcChartCbs = [cb];
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.6.0/Chart.min.js';
    s.async = true;
    s.onload = function () { (window.__a2fcChartCbs || []).forEach(function (f) { f(); }); window.__a2fcChartCbs = []; };
    document.head.appendChild(s);
  }

  function buttonPress(fitKnown) {
    var fit, searchOpts = {}, saddleMM = 0, recInfo = null, totalIn = 0, inseamIn = 0, inseamDelta = 0;
    if (fitKnown == true) {
      if (document.getElementById("padx").value == "" || document.getElementById("pady").value == "") {
        document.getElementById("op1p").innerHTML = "Please enter your pad X/Y.";
        return;
      } else if (/\D/.test(document.getElementById("padx").value) || /\D/.test(document.getElementById("pady").value)) {
        document.getElementById("op1p").innerHTML = "Please only enter whole numbers for pad X/Y.";
        return;
      }
      fit = {
        userpadx: Number(document.getElementById("padx").value),
        userpady: Number(document.getElementById("pady").value)
      };
    } else if (fitKnown == false) {
      var unitEl = document.querySelector('input[name="a2fcUnits"]:checked');
      var unit = unitEl ? unitEl.value : "in";
      var height, inseam;
      var iRaw = parseFloat(document.getElementById("fitCalc__input_inseam").value);
      if (unit === "in") {
        var hFt = parseFloat(document.getElementById("fitCalc__input_height_ft").value);
        var hIn = parseFloat(document.getElementById("fitCalc__input_height_in").value);
        if (isNaN(hFt) && isNaN(hIn)) { document.getElementById("op1p").innerHTML = "Please enter your height (feet and inches)."; return; }
        height = ((isNaN(hFt) ? 0 : hFt) * 12 + (isNaN(hIn) ? 0 : hIn)) * 25.4;
        inseam = iRaw * 25.4;
      } else {
        var hCm = parseFloat(document.getElementById("fitCalc__input_height").value);
        if (isNaN(hCm)) { document.getElementById("op1p").innerHTML = "Please enter your height in centimeters."; return; }
        height = hCm * 10;
        inseam = iRaw * 10;
      }
      if (isNaN(iRaw)) {
        document.getElementById("op1p").innerHTML = "Please enter your inseam.";
        return;
      }
      if (height < 1200 || height > 2200 || inseam < 500 || inseam > 1200 || inseam >= height) {
        document.getElementById("op1p").innerHTML = "Those numbers look off — double-check your height and inseam (" + (unit === "in" ? "in inches" : "in centimeters") + ").";
        return;
      }
      // Hard fence: the SP fits riders ~5'3"–6'5" (63"–77"). Outside that, DO
      // NOT recommend a size — route them to the fit team instead. Epsilon
      // guards the exact boundary heights against mm round-trip error.
      var totalInGate = height / 25.4;
      if (totalInGate < 62.95 || totalInGate > 77.05) {
        var gft = Math.floor(totalInGate / 12), gin = Math.round(totalInGate - gft * 12);
        if (gin >= 12) { gft += 1; gin -= 12; }
        document.getElementById("op1p").innerHTML =
          "<h3>Let's find your fit personally</h3><p class=\"a2fc-why\">The SP is built for riders about <b>5&prime;3&Prime; to 6&prime;5&Prime;</b>. At <b>" + gft + "&prime;" + gin + "&Prime;</b> you're outside our stock size range, so we don't want to guess your fit &mdash; <a href=\"/pages/contact-a2-bikes\">talk to our fit team</a> and we'll find the right setup (or the right bike) for you.</p>";
        document.getElementById("op2p").innerHTML = "";
        document.getElementById("op3p").innerHTML = "";
        document.getElementById("padyxdisplaybox").innerHTML = "";
        if (window.a2dl) { window.a2dl("fit_calculator_result", { recommended_frame: "out_of_range" }); }
        return;
      }
      var saddle = 0.9 * inseam;
      saddleMM = saddle;
      fit = {
        userpadx: 0.29 * height + (0.42 - saddle / height) * 500,
        userpady: 0.35 * height - (0.42 - saddle / height) * 400
      };
      // ONE size, sized UP when between (owner rule): a too-small frame can
      // never be made big enough and forces a long stem + tall spacer tower
      // that wreck handling, while a slightly large frame is easily brought
      // down with the stem and pads. The frame is chosen from height + inseam;
      // the Pad X/Y search then dials in the stem/spacer/pad WITHIN that frame.
      totalIn = height / 25.4;
      inseamIn = inseam / 25.4;
      inseamDelta = inseamIn - a2fcAvgInseam(totalIn);
      recInfo = a2fcRecommendFrame(totalIn, inseamIn);
      searchOpts.allowed = [recInfo.frame];
    }

    fit_array = buildFitArray(a2fcConfigKey());
    fit = findCombinations(fit.userpadx, fit.userpady, fit_array, searchOpts);

    var rec = fit.options[0], recFrame = rec.frame;
    if (!recInfo) {
      // Expert "I know my Pad X/Y" path: no height to gate on. Bias UP on a
      // near-tie with a larger frame (owner rule: size up when between).
      for (var oi = 1; oi < fit.options.length; oi++) {
        var alt = fit.options[oi];
        if (frame_key.indexOf(alt.frame) > frame_key.indexOf(rec.frame) && (alt.error - rec.error) <= 12) { rec = alt; recFrame = alt.frame; }
      }
    }
    var sizeNames = { S: "Small", M: "Medium", L: "Large", XL: "XL" };
    var recName = sizeNames[recFrame] || recFrame;

    document.getElementById("op1p").innerHTML =
      "<h3>Your size: the " + recName + "</h3>" + a2fcExplain(recInfo, recFrame, totalIn, inseamIn, inseamDelta) + a2fcSetupHtml(rec);
    document.getElementById("op2p").innerHTML = "";
    document.getElementById("op3p").innerHTML = "";

    var box = "<h4>Target pad stack (Y): " + String(Math.round(fit.userpady)) + "mm<br>Target pad reach (X): " + String(Math.round(fit.userpadx)) + "mm</h4>";
    if (saddleMM) {
      // Drop = top of saddle down to top of the elbow pads (both up from BB).
      var drop = Math.round(saddleMM - rec.pady);
      box += "<div class=\"a2-fit-calc__drop\"><b>Saddle-to-pad drop: " + drop + "mm</b> &mdash; " + a2fcDropDesc(drop) +
        "<br><span>Saddle height starts around " + Math.round(saddleMM) + "mm (" + (Math.round(saddleMM / 25.4 * 10) / 10) +
        "&Prime;). More drop is faster but more aggressive; less or positive drop is more comfortable, trading a little aero. " +
        "On your " + recName + " you tune this with the pads and spacers &mdash; no size change needed. Confirm with a pro fit before race day.</span></div>";
    }
    document.getElementById("padyxdisplaybox").innerHTML = box;

    showChart(fit, rec);
    if (window.a2dl) { window.a2dl("fit_calculator_result", { recommended_frame: recFrame }); }
  }

  // Plain-language read on the saddle-to-pad drop (mm) for an SP triathlon fit.
  // Guidance only — a professional bike fit is the final word.
  function a2fcDropDesc(drop) {
    if (drop >= 160) { return "a very aggressive, maximally aero position"; }
    if (drop >= 120) { return "an aggressive, aero position"; }
    if (drop >= 70) { return "a balanced position &mdash; aero but sustainable"; }
    if (drop >= 30) { return "a relaxed, comfort-first position"; }
    if (drop >= 0) { return "a very relaxed, comfort-first position"; }
    return "an upright position &mdash; pads above the saddle";
  }

  function beginFit(fitKnown) {
    document.getElementById("enterPadXY").style.display = fitKnown ? "block" : "none";
    document.getElementById("enterMeasurements").style.display = fitKnown ? "none" : "block";
    var btns = document.querySelectorAll(".fitCalc__div_fitKnown_buttons .fitCalcButton");
    if (btns.length === 2) {
      btns[0].setAttribute("aria-pressed", fitKnown ? "false" : "true");
      btns[1].setAttribute("aria-pressed", fitKnown ? "true" : "false");
    }
  }

  function toggleFit() { showMe("togglefit"); showMe("fitfinder"); }

  function a2fcUnitsChanged() {
    var unitEl = document.querySelector('input[name="a2fcUnits"]:checked');
    var isIn = !unitEl || unitEl.value === "in";
    document.getElementById("a2fcHeightImperial").style.display = isIn ? "flex" : "none";
    document.getElementById("a2fcHeightMetric").style.display = isIn ? "none" : "flex";
    document.querySelectorAll(".a2fcUnit").forEach(function (el) { el.textContent = isIn ? "in" : "cm"; });
    document.getElementById("fitCalc__input_inseam").placeholder = isIn ? "32" : "81";
  }

  function showMe(showBox) {
    var el = document.getElementById(showBox);
    el.style.display = (el.style.display == "block") ? "none" : "block";
  }

  function showChart(fit, rec) {
    a2fcEnsureChart(function () {
      var colors = { frame_s: "#5b5be0", frame_m: "#e8527e", frame_l: "#f29a3c", frame_xl: "#cbe23c" };
      var fit_points = { S: [], M: [], L: [], XL: [] };
      for (var i = fit_array.length - 1; i >= 0; i--) {
        if (fit_points[fit_array[i].frame]) { fit_points[fit_array[i].frame].push({ x: fit_array[i].padx, y: fit_array[i].pady }); }
      }
      var ctx = document.getElementById("myChart").getContext("2d");
      new Chart(ctx, {
        type: "scatter",
        data: { datasets: [
          { pointRadius: 7, pointBackgroundColor: "#111", backgroundColor: "#111", label: "Your fit point", showLine: false, data: [{ x: fit.userpadx, y: fit.userpady }] },
          { pointRadius: 6, pointBackgroundColor: "#1F8A4C", backgroundColor: "#1F8A4C", label: "Your " + rec.frame + " setup", showLine: false, data: [{ x: rec.padx, y: rec.pady }] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_s, backgroundColor: colors.frame_s, label: "Size S", showLine: false, data: fit_points["S"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_m, backgroundColor: colors.frame_m, label: "Size M", showLine: false, data: fit_points["M"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_l, backgroundColor: colors.frame_l, label: "Size L", showLine: false, data: fit_points["L"] },
          { pointRadius: 2, pointBackgroundColor: colors.frame_xl, backgroundColor: colors.frame_xl, label: "Size XL", showLine: false, data: fit_points["XL"] }
        ]},
        options: {
          legend: { display: true, position: "right" },
          title: { display: true, text: "Fit Point Plot" },
          scales: {
            xAxes: [{ type: "linear", position: "bottom", scaleLabel: { display: true, labelString: "Pad Center X [mm]" } }],
            yAxes: [{ scaleLabel: { display: true, labelString: "Pad Y [mm]" } }]
          },
          tooltips: { callbacks: { label: function (t, d) { var l = String(d.datasets[t.datasetIndex].label); return l + ": (" + t.xLabel + ", " + t.yLabel + ")"; } } }
        }
      });
    });
  }

  // --- Fit geometry (A2 SP fit sheets V0.01, June 2026) ----------------------
  // Bases = pad position at rail center, shortest stem, zero risers.
  var fit_configs = {
    metron: {
      label: "Shimano 105 / SRAM Rival — Vision Metron Alloy clip-ons",
      sizes: { S: [450.1, 552.4], M: [473.0, 585.8], L: [495.0, 619.8], XL: [517.1, 653.7] },
      stems: [[0, 0, "A2 SP 78mm"], [14.4, 3.2, "A2 SP 93mm"], [28.9, 6.3, "A2 SP 108mm"]],
      pads: [-16, -8, 0, 8, 16]
    },
    si013: {
      label: "SRAM Force / Red — Vision Si013",
      sizes: { S: [535.5, 579.0], M: [558.5, 612.2], L: [581.2, 645.8], XL: [603.0, 679.1] },
      stems: [[0, 0, "A2 SP 78mm"], [12.1, 3.0, "A2 SP 93mm"], [24.2, 5.9, "A2 SP 108mm"]],
      pads: [-64, -48, -32, -16, 0, 16, 32, 48, 64]
    }
  };
  var spacer_steps = [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65, 70];
  var frame_key = ["S", "M", "L", "XL"];
  var fit_array = [];

  // SP frame by rider height (inches) — same bands as the PDP Size Calculator.
  function a2fcBandFrame(totalIn) {
    if (totalIn < 66.5) { return "S"; }   // 63-66"
    if (totalIn < 70.5) { return "M"; }   // 67-70"
    if (totalIn < 74.5) { return "L"; }   // 71-74"
    return "XL";                          // 75"+
  }
  var sp_avg_inseam = { 63: 29.5, 64: 30, 65: 30.5, 66: 31, 67: 31.5, 68: 32, 69: 32.5, 70: 33, 71: 33.5, 72: 34, 73: 34.5, 74: 35, 75: 35.5, 76: 36, 77: 36.5 };
  function a2fcAvgInseam(totalIn) { return sp_avg_inseam[Math.round(totalIn)] || 32; }

  // ONE recommended frame from height + inseam, sized UP when between sizes.
  // Published SP bands (inches): S 63-66, M 67-70, L 71-74, XL 75-77.
  function a2fcRecommendFrame(totalIn, inseamIn) {
    var bands = [
      { f: "S",  min: 63, max: 66 },
      { f: "M",  min: 67, max: 70 },
      { f: "L",  min: 71, max: 74 },
      { f: "XL", min: 75, max: 77 }
    ];
    var delta = inseamIn - a2fcAvgInseam(totalIn);
    var idx = -1, between = false, reason = "in-band";
    for (var i = 0; i < bands.length; i++) {
      if (totalIn >= bands[i].min && totalIn <= bands[i].max) { idx = i; break; }
    }
    if (idx === -1) {
      if (totalIn < bands[0].min) { idx = 0; }
      else if (totalIn > bands[bands.length - 1].max) { idx = bands.length - 1; }
      else {
        // in the gap between two bands -> size UP
        for (var j = 0; j < bands.length - 1; j++) {
          if (totalIn > bands[j].max && totalIn < bands[j + 1].min) { idx = j + 1; between = true; reason = "boundary"; break; }
        }
      }
    } else if (idx < bands.length - 1) {
      if (totalIn >= bands[idx].max - 0.75) { idx += 1; between = true; reason = "boundary"; } // near top of band
      else if (delta >= 1.5) { idx += 1; between = true; reason = "inseam"; }                  // long legs for height
    }
    return { frame: bands[idx].f, idx: idx, between: between, reason: reason,
             fromFrame: between && idx > 0 ? bands[idx - 1].f : null };
  }

  // Stock fitter-style explanation; adapts to the size, whether we sized up,
  // and how the rider's inseam compares to average for their height.
  function a2fcExplain(recInfo, frame, totalIn, inseamIn, inseamDelta) {
    var names = { S: "Small", M: "Medium", L: "Large", XL: "XL" };
    var name = names[frame] || frame;
    if (!recInfo) {
      return "<p class=\"a2fc-why\">Matched to the Pad X / Y you entered: the <b>" + name + "</b> places those armrest coordinates near the middle of its cockpit range, so you keep room to fine-tune in every direction. Between two sizes we go with the larger &mdash; you can always bring a bigger frame lower and tighter, but you can't make a small one fit.</p>";
    }
    var ft = Math.floor(totalIn / 12), inch = Math.round(totalIn - ft * 12);
    if (inch >= 12) { ft += 1; inch -= 12; }
    var ftin = ft + "&prime;" + inch + "&Prime;";
    var inseamTxt = (Math.round(inseamIn * 10) / 10) + "&Prime;";
    var html = "<p class=\"a2fc-why\">At <b>" + ftin + "</b> with a <b>" + inseamTxt + "</b> inseam, the <b>" + name + "</b> is the frame whose stack and reach land your aerobar pads in the middle of their range &mdash; low enough to get aero, with room to fine-tune fore/aft and height instead of maxing out the stem or spacer stack.";
    if (recInfo.between && recInfo.reason === "boundary") {
      html += " You're right between the " + (names[recInfo.fromFrame] || recInfo.fromFrame) + " and the " + name + ", so we size up. A slightly larger frame comes lower and tighter with the stem and pads, but a too-small frame can never be made big enough &mdash; stretching to reach off a small frame forces a long stem and a tall spacer stack that hurt handling and aerodynamics.";
    } else if (recInfo.between && recInfo.reason === "inseam") {
      html += " Your inseam is long for your height, so we size up to the " + name + " for the standover clearance and saddle height your legs want.";
    } else if (inseamDelta <= -1.5) {
      html += " Your inseam runs a little short for your height &mdash; more torso than leg &mdash; which the " + name + "&rsquo;s reach suits; you'll set the saddle slightly lower and the cockpit has the range to dial it in.";
    } else if (inseamDelta >= 1.5) {
      html += " Your inseam is a touch long for your height, so you have plenty of standover on the " + name + " and will run a taller saddle.";
    } else {
      html += " Your proportions are about average for your height, so standover, saddle height and reach all land where the " + name + " is designed to sit.";
    }
    html += "</p><p class=\"a2fc-why a2fc-why--exch\">Not sure? Free size exchanges either way &mdash; but for your numbers, the " + name + " is a confident call.</p>";
    return html;
  }

  function a2fcConfigKey() {
    var el = document.querySelector('input[name="a2fcBuild"]:checked');
    return el ? el.value : "metron";
  }

  function buildFitArray(cfgKey) {
    var cfg = fit_configs[cfgKey], arr = [];
    // Limits of this build's adjustment range, for the edge penalty below.
    var maxStemX = 0, maxPad = 0, maxSp = spacer_steps[spacer_steps.length - 1];
    for (var s = 0; s < cfg.stems.length; s++) { if (cfg.stems[s][0] > maxStemX) { maxStemX = cfg.stems[s][0]; } }
    for (var p = 0; p < cfg.pads.length; p++) { if (Math.abs(cfg.pads[p]) > maxPad) { maxPad = Math.abs(cfg.pads[p]); } }
    for (var i = 0; i < frame_key.length; i++) {
      for (var j = 0; j < cfg.stems.length; j++) {
        for (var k = 0; k < spacer_steps.length; k++) {
          for (var m = 0; m < cfg.pads.length; m++) {
            arr.push({
              frame: frame_key[i],
              stem: cfg.stems[j][2],
              pedSpacers: spacer_steps[k],
              pad: cfg.pads[m],
              // How hard this setup leans on the limits of the adjustment
              // range (tall spacer tower / longest stem / extreme pad offset).
              // Keeps the search from picking a maxed-out small frame.
              edge: 18 * (maxSp ? spacer_steps[k] / maxSp : 0) +
                    10 * (maxStemX ? cfg.stems[j][0] / maxStemX : 0) +
                    8 * (maxPad ? Math.abs(cfg.pads[m]) / maxPad : 0),
              padx: Math.round(cfg.sizes[frame_key[i]][0] + cfg.stems[j][0] + cfg.pads[m]),
              pady: Math.round(cfg.sizes[frame_key[i]][1] + cfg.stems[j][1] + spacer_steps[k])
            });
          }
        }
      }
    }
    return arr;
  }

  function findCombinations(padx, pady, fit_data, opts) {
    opts = opts || {};
    var allowed = opts.allowed || null; // array of frame keys, or null = any frame
    var combinations = fit_data;
    var fit = { userpady: pady, userpadx: padx };
    for (var i = combinations.length - 1; i >= 0; i--) {
      var c = combinations[i];
      c.error = ((c.padx - fit.userpadx) ** 2 + (c.pady - fit.userpady) ** 2) ** 0.5;
      // Rank by fit error PLUS an edge penalty, so a maxed-out setup loses to
      // a centered one. When a height band is known, frames outside it are
      // pushed to the bottom (kept only as fallback alternates).
      c.score = c.error + c.edge + (allowed && allowed.indexOf(c.frame) === -1 ? 9999 : 0);
    }
    fit.options = [combinations[0], combinations[1], combinations[2]];
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].score < fit.options[0].score) { fit.options[0] = combinations[i]; }
    }
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].score < fit.options[1].score && combinations[i].frame != fit.options[0].frame) { fit.options[1] = combinations[i]; }
    }
    for (var i = combinations.length - 1; i >= 0; i--) {
      if (combinations[i].score < fit.options[2].score && combinations[i].frame != fit.options[0].frame && combinations[i].frame != fit.options[1].frame) { fit.options[2] = combinations[i]; }
    }
    fit.options.sort(function (a, b) { return a.score - b.score; });
    fit.userpadx = Math.round(fit.userpadx * 10) / 10;
    fit.userpady = Math.round(fit.userpady * 10) / 10;
    return fit;
  }

  function a2fcSetupHtml(c) {
    return "<div class=\"a2fc-setup\"><b>Starting cockpit setup</b><br>" +
      "Frame: A2 SP " + c.frame + " &middot; " + c.stem + " stem &middot; " + c.pedSpacers + "mm spacers &middot; armrests " + (c.pad > 0 ? "+" : "") + c.pad + "mm fore/aft<br>" +
      "Pad stack / reach: " + c.pady + " / " + c.padx + "mm</div>";
  }
}
</script>
