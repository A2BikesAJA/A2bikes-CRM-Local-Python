        "accordion_xkAn4T": {
          "type": "accordion",
          "settings": {
            "expand_by_default": true,
            "column_placement": "left",
            "heading": "A2 Bikes Sizing Calculator",
            "heading_tag": "h3",
            "content": "<p>Add your collapsible row content here.</p>",
            "page_for_content": "sp-sizing",
            "custom_liquid": "<style>\n  .bike-size-calculator {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 40px;\n    padding: 20px;\n    border: 1px solid #eee;\n    background: #fafafa;\n    border-radius: 8px;\n  }\n\n  .calculator-inputs {\n    flex: 1;\n    min-width: 260px;\n  }\n\n  .calculator-results {\n    flex: 1;\n    min-width: 260px;\n    border-left: 2px solid #ddd;\n    padding-left: 30px;\n  }\n\n  .bike-size-calculator h3 {\n    font-family: 'Fraunces', serif;\n    font-size: 22px;\n    margin-bottom: 12px;\n    color: #000;\n  }\n\n  .bike-size-calculator label {\n    display: block;\n    margin-bottom: 8px;\n    font-size: 18px;\n    font-family: 'Fraunces', serif;\n    font-weight: 500;\n    color: #111;\n  }\n\n  .bike-size-calculator select, \n  .bike-size-calculator input {\n    width: 100%;\n    padding: 8px 10px;\n    font-size: 16px;\n    margin-bottom: 16px;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n  }\n\n  .result-highlight {\n    font-family: 'Fraunces', serif;\n    font-size: 26px;\n    font-weight: 700;\n    color: #C51C26; /* A2 red */\n    margin-top: 8px;\n  }\n\n  .bike-size-calculator button {\n    background-color: #000;\n    color: #fff;\n    border: none;\n    padding: 12px 24px;\n    font-size: 16px;\n    font-weight: 600;\n    font-family: 'Fraunces', serif;\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n\n  .bike-size-calculator button:hover {\n    background-color: #C51C26;\n  }\n</style>\n\n<div class=\"bike-size-calculator\">\n  <div class=\"calculator-inputs\">\n    <h3>Find Your Size</h3>\n    <label for=\"height\">Your Height</label>\n    <input type=\"text\" id=\"height\" placeholder=\"e.g. 5'9&quot;\">\n    \n    <label for=\"inseam\">Your Inseam</label>\n    <input type=\"text\" id=\"inseam\" placeholder=\"e.g. 32&quot;\">\n    \n    <button onclick=\"calculateBikeSize()\">See My Size</button>\n  </div>\n\n  <div class=\"calculator-results\">\n    <h3>Recommended Size</h3>\n    <div id=\"size-result\" class=\"result-highlight\">—</div>\n    <p id=\"bike-model\">We’ll suggest the best SP or Rogue size for you.</p>\n  </div>\n</div>\n\n<script>\n  function calculateBikeSize() {\n    const height = document.getElementById('height').value;\n    const inseam = document.getElementById('inseam').value;\n    let result = \"Medium\";\n    let model = \"SP Triathlon or Rogue All-Road\";\n\n    // Simple height-based logic (update with your chart)\n    if (height.includes(\"5'3\") || height.includes(\"5'4\") || height.includes(\"5'5\") || height.includes(\"5'6\")) {\n      result = \"Small\";\n    } else if (height.includes(\"5'7\") || height.includes(\"5'8\") || height.includes(\"5'9\") || height.includes(\"5'10\")) {\n      result = \"Medium\";\n    } else if (height.includes(\"5'11\") || height.includes(\"6'0\") || height.includes(\"6'1\") || height.includes(\"6'2\")) {\n      result = \"Large\";\n    } else if (height.includes(\"6'3\") || height.includes(\"6'4\") || height.includes(\"6'5\")) {\n      result = \"XL\";\n    }\n\n    document.getElementById('size-result').innerText = result;\n    document.getElementById('bike-model').innerText = `Recommended build: ${model} (${result})`;\n  }\n</script>"
          }
        },
