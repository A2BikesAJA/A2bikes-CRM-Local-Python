    "rich_text_VjCnkn": {
      "type": "rich-text",
      "blocks": {
        "heading_FatPa6": {
          "type": "heading",
          "settings": {
            "title": "A2's Flagship Model",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-2-base"
          }
        },
        "text_rx4tNX": {
          "type": "text",
          "settings": {
            "text": "<p>Starting at only <strong>$3,115</strong>, </p><p><strong>The SP is over-built, not over-priced. </strong></p><p>It delivers pro-level performance without the pro-level price. Trusted at the Ironman World Championships and equally at home guiding first-time triathletes to their finish line, the SP proves that speed and value can coexist. With wind-tunnel-refined aerodynamics, infinitely adjustable geometry, and bulletproof components, it's built to help you train smarter, race faster, and achieve your goals.</p>",
            "text_font_class": "fs-body-100"
          }
        }
      },
      "block_order": [
        "heading_FatPa6",
        "text_rx4tNX"
      ],
      "name": "t:sections.rich_text.presets.name",
      "settings": {
        "alignment": "center_center",
        "enable_animation": true,
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-only",
