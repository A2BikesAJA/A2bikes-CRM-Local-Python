      "blocks": {
        "r1": { "type": "review", "settings": { "quote": "My first carbon bike and I was nervous about the assembly. The seatpost and cockpit took me about 40 minutes with the video. Riding it the same afternoon.", "name": "Marcus T.", "sub": "SP 105 owner" } },
        "r2": { "type": "review", "settings": { "quote": "I'm 6'4″ with a long torso and have never found a stock tri bike that fit. The SAGS cockpit dialed me in perfectly. Force AXS shifting is flawless.", "name": "Dana R.", "sub": "SP Force AXS owner" } },
        "r3": { "type": "review", "settings": { "quote": "Quoted over $11K for a comparable superbike elsewhere. The Red AXS build came in thousands less and the support has been genuinely excellent.", "name": "Priya S.", "sub": "SP Red AXS owner" } },
