    "custom_liquid_yVtH7r": {
      "type": "custom-liquid",
      "name": "t:sections.custom_liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"text-align: center; margin: 30px 0;\">\n  <button id=\"see-bikes-btn\" style=\"\n    background-color: #FCFCF9;\n    color: #000;\n    border: 1.5px solid #000;\n    padding: 14px 28px;\n    font-size: 24px;\n    font-weight: 500;\n    text-transform: capitalize;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    font-family: 'Fraunces', serif;\n  \">Shop The Rogue Here</button>\n</div>\n\n<script>\n  document.getElementById('see-bikes-btn').addEventListener('click', function() {\n    // Common selectors for the product grid\n    const selectors = [\n      '#CollectionSection',\n      '.collection__products',\n      '.grid--collection',\n      '.grid.grid--uniform',\n      '#main-collection-products',\n      '.collection-products-wrapper',\n      '.product-grid'\n    ];\n\n    let target = null;\n\n    for (const sel of selectors) {\n      const el = document.querySelector(sel);\n      if (el) {\n        target = el;\n        break;\n      }\n    }\n\n    // Fallback: try to find a container with product items\n    if (!target) {\n      const productCards = document.querySelectorAll('.product-card, .grid__item');\n      if (productCards.length > 0) {\n        target = productCards[0].closest('section, div');\n      }\n    }\n\n    // Scroll if a target was found\n    if (target) {\n      target.scrollIntoView({ behavior: 'smooth', block: 'start' }); // scroll to top\n    }\n  });\n</script>",
        "divider_style": "none",
        "section_padding": "section--vertical-padding-none"
      }
    },
