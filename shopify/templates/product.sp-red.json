          "settings": {
            "stars": "\u2605\u2605\u2605\u2605\u2605",
            "result": "First 70.3 \u00b7 5:42",
            "quote": "My first carbon tri bike. I'm not a pro \u2014 I just wanted to stop getting dropped on the bike leg. It fit out of the box once I used their sizing call, and I genuinely felt faster.",
            "name": "Marcus T.",
            "context": "Age-grouper, Columbus OH",
            "verified": false
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "stars": "\u2605\u2605\u2605\u2605\u2605",
            "result": "3rd AG \u00b7 Olympic",
            "quote": "Honest take: assembly took me about an hour and the headset needed patience. But for the money there's nothing close. The SAGS cockpit let me get low without buying parts.",
            "name": "Dana R.",
            "context": "2nd season, Boulder CO",
            "verified": false
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "stars": "\u2605\u2605\u2605\u2605\u2606",
            "result": "New to tri",
            "quote": "Shopped the Cerv\u00e9lo and QR at my local shop and walked out because of the price. Glad I waited. Just works, and support actually answered when I had a routing question.",
            "name": "Priya S.",
            "context": "Beginner, Austin TX",
            "verified": false
          }
        }
