          "settings": {
            "tab_heading": "Spec Guide",
            "heading_column_1": "SP Force AXS Spec Guide",
            "heading_font_class_column_1": "fs-heading-4-base",
            "heading_tag_column_1": "h2",
            "text_column_1": "",
            "page_for_content_column_1": "{{ product.metafields.custom.component_guide_page.value }}",
            "custom_liquid_column_1": "",
            "text_font_class_column_1": "fs-body-100",
