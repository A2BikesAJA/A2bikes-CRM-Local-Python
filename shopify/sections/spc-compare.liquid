{% render 'spc-assets' %}
<div class="spc">
  <section class="spc-sec spc-compare" id="spc-compare">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.heading }}</h2>
      </div>
      <p class="spc-cue" aria-live="polite"></p>

      <div class="spc-grid spc-reveal" style="grid-template-columns:172px repeat({{ section.blocks.size }}, minmax(0,1fr));">
        <div class="spc-labels">
          <div class="spc-cell spc-cell--head"></div>
          <div class="spc-cell spc-cell--price">Price</div>
          <div class="spc-cell">Groupset</div>
          <div class="spc-cell">Shifting</div>
          <div class="spc-cell">Drivetrain</div>
          <div class="spc-cell">Wheels</div>
          <div class="spc-cell">Brakes</div>
          <div class="spc-cell">Best for</div>
          <div class="spc-cell">Affirm monthly</div>
          <div class="spc-cell"></div>
        </div>

        {%- for block in section.blocks -%}
          {%- assign blink = block.settings.link | default: '/collections/sp' -%}
          <div class="spc-col" data-build="{{ block.settings.key | escape }}" data-key="{{ block.settings.key | escape }}" data-name="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
            <div class="spc-rec-badge">Recommended</div>
            <div class="spc-cell spc-cell--head spc-bhead">
              <div class="spc-bhead__media{% unless block.settings.image %} spc-ph spc-ph--light{% endunless %}"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 800 }})"{% else %} data-label="{{ block.settings.name | escape }} image"{% endif %}></div>
              <div class="spc-bhead__text">
                <div class="spc-bhead__name">{{ block.settings.name }}</div>
                <div class="spc-bhead__pos">{{ block.settings.pos }}</div>
              </div>
            </div>
            <div class="spc-cell spc-cell--price"><span class="spc-cell-label">Price</span><span class="spc-bprice">{{ block.settings.price }}</span></div>
            <div class="spc-cell"><span class="spc-cell-label">Groupset</span>{{ block.settings.groupset }}</div>
            <div class="spc-cell"><span class="spc-cell-label">Shifting</span><span class="spc-shift">{% if block.settings.shifting == 'Electronic' %}{% render 'spc-icon', icon: 'lightning' %}{% else %}{% render 'spc-icon', icon: 'gear' %}{% endif %}{{ block.settings.shifting }}</span></div>
            <div class="spc-cell"><span class="spc-cell-label">Drivetrain</span>{{ block.settings.drivetrain }}</div>
            <div class="spc-cell"><span class="spc-cell-label">Wheels</span>{{ block.settings.wheels }}</div>
            <div class="spc-cell"><span class="spc-cell-label">Brakes</span>{{ block.settings.brakes }}</div>
            <div class="spc-cell"><span class="spc-cell-label">Best for</span><span class="spc-bestfor">{{ block.settings.bestfor }}</span></div>
            <div class="spc-cell spc-cell--affirm"><span class="spc-cell-label">Affirm monthly</span>From <b>{{ block.settings.affirm }}/mo</b> at 0% APR</div>
            <div class="spc-cell spc-cell--cta">
              <a class="spc-btn spc-btn--primary" href="{{ blink }}" data-build-cta="{{ block.settings.key | escape }}">Shop the SP {{ block.settings.short }}</a>
              <a class="spc-specs" href="{{ blink }}#specs">See full specs <span class="spc-arw">→</span></a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <p class="spc-hint">← Swipe to compare all builds →</p>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "SP · Comparison table",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare the builds" }
  ],
  "blocks": [
    {
      "type": "build",
      "name": "Build column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "SP — Shimano 105" },
        { "type": "text", "id": "short", "label": "Short name (CTA: \"Shop the SP __\")", "default": "105" },
        { "type": "text", "id": "key", "label": "Key (lowercase id; pills reference this)", "default": "105" },
        { "type": "text", "id": "pos", "label": "Positioning line", "default": "For your first carbon tri bike" },
        { "type": "text", "id": "price", "label": "Price", "default": "$3,115" },
        { "type": "text", "id": "groupset", "label": "Groupset", "default": "Shimano 105 R7100, 12-speed mechanical" },
        { "type": "select", "id": "shifting", "label": "Shifting", "options": [{ "value": "Electronic", "label": "Electronic" }, { "value": "Mechanical", "label": "Mechanical" }], "default": "Mechanical" },
        { "type": "text", "id": "drivetrain", "label": "Drivetrain", "default": "12-speed · 11–34 cassette" },
        { "type": "text", "id": "wheels", "label": "Wheels", "default": "Vision Team 30 alloy" },
        { "type": "text", "id": "brakes", "label": "Brakes", "default": "Mechanical disc" },
        { "type": "textarea", "id": "bestfor", "label": "Best for", "default": "First-time carbon tri bike. Proven mechanical reliability." },
        { "type": "text", "id": "affirm", "label": "Affirm monthly (amount only)", "default": "$260" },
        { "type": "url", "id": "link", "label": "Product link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SP · Comparison table",
      "blocks": [
        { "type": "build", "settings": { "name": "SP — Shimano 105", "short": "105", "key": "105", "pos": "For your first carbon tri bike", "price": "$3,115", "groupset": "Shimano 105 R7100, 12-speed mechanical", "shifting": "Mechanical", "drivetrain": "12-speed · 11–34 cassette", "wheels": "Vision Team 30 alloy", "brakes": "Mechanical disc", "bestfor": "First-time carbon tri bike. Proven mechanical reliability.", "affirm": "$260" } },
        { "type": "build", "settings": { "name": "SP — SRAM Rival AXS", "short": "Rival AXS", "key": "rival", "pos": "For value-minded racers", "price": "$5,795", "groupset": "SRAM Rival AXS, 12-speed wireless electronic", "shifting": "Electronic", "drivetrain": "12-speed · 10–36 cassette", "wheels": "Vision Team 30 alloy, tubeless-ready", "brakes": "Hydraulic disc", "bestfor": "Electronic shifting at the lowest price. Race-ready for serious age groupers.", "affirm": "$483" } },
        { "type": "build", "settings": { "name": "SP — SRAM Force AXS", "short": "Force AXS", "key": "force", "pos": "For competitive racing", "price": "$7,273", "groupset": "SRAM Force AXS, 12-speed wireless electronic", "shifting": "Electronic", "drivetrain": "12-speed · 10–36 cassette", "wheels": "Zipp 404 carbon — free upgrade", "brakes": "Hydraulic disc", "bestfor": "Competitive racing without the top-tier price. The performance sweet spot.", "affirm": "$606" } },
        { "type": "build", "settings": { "name": "SP — SRAM Red AXS", "short": "Red AXS", "key": "red", "pos": "For the podium", "price": "$8,971", "groupset": "SRAM Red AXS, 12-speed wireless electronic", "shifting": "Electronic", "drivetrain": "12-speed · 10–36 cassette", "wheels": "Zipp 808 carbon", "brakes": "Hydraulic disc · Paceline rotors", "bestfor": "Top-tier components. Built for athletes targeting Kona qualification.", "affirm": "$748" } }
      ]
    }
  ]
}
{% endschema %}
