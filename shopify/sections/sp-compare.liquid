          <div class="spc-same-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3>{{ section.settings.same3_title }}</h3>
          <p>{{ section.settings.same3_body }}</p>
        </div>
        <div class="spc-same-card spc-reveal d3">
          <div class="spc-same-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 9l9 6 9-6"/></svg></div>
          <h3>{{ section.settings.same4_title }}</h3>
          <p>{{ section.settings.same4_body }}</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 4 · FINANCING ===== {%- endcomment -%}
  <section class="spc-sec spc-pay">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.pay_eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.pay_heading }}</h2>
        <p class="spc-lede">{{ section.settings.pay_lede }}</p>
      </div>
      <div class="spc-pay-grid">
        <div class="spc-pay-card spc-reveal">
          <div class="spc-pay-card__brand"><span class="spc-wordmark">{{ section.settings.pay1_wordmark }}</span></div>
          <h3>{{ section.settings.pay1_heading }}</h3>
          <p>{{ section.settings.pay1_body }}</p>
          <a class="spc-pay-link" href="{{ pay1_link }}" data-financing="affirm">{{ section.settings.pay1_link_label }} <span class="spc-arw">→</span></a>
        </div>
        <div class="spc-pay-card spc-reveal d1">
          <div class="spc-pay-card__brand"><span class="spc-wordmark">{{ section.settings.pay2_wordmark }}</span></div>
          <h3>{{ section.settings.pay2_heading }}</h3>
          <p>{{ section.settings.pay2_body }}</p>
          <a class="spc-pay-link" href="{{ pay2_link }}" data-financing="truemed">{{ section.settings.pay2_link_label }} <span class="spc-arw">→</span></a>
        </div>
        <div class="spc-pay-card spc-reveal d2">
          <div class="spc-pay-card__brand"><span class="spc-wordmark">{{ section.settings.pay3_wordmark }}</span></div>
          <h3>{{ section.settings.pay3_heading }}</h3>
          <p>{{ section.settings.pay3_body }}</p>
          <a class="spc-pay-link" href="{{ pay3_link }}" data-financing="govx">{{ section.settings.pay3_link_label }} <span class="spc-arw">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 5 · SIZING ===== {%- endcomment -%}
  <section class="spc-sec spc-sizing">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.sizing_eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.sizing_heading }}</h2>
      </div>
      <div class="spc-sizing-grid">
        <div class="spc-sizing-card spc-sizing-card--calc spc-reveal">
          <span class="spc-sizing-eyebrow">{{ section.settings.calc_eyebrow }}</span>
          <h3>{{ section.settings.calc_heading }}</h3>
          <p>{{ section.settings.calc_body }}</p>
          <form class="spc-calc" novalidate>
            <div class="spc-calc-fields">
              <div class="spc-calc-field">
                <label for="spcCalcFt">Height (ft)</label>
                <input type="number" id="spcCalcFt" data-calc="ft" min="4" max="7" inputmode="numeric" placeholder="5">
              </div>
              <div class="spc-calc-field">
                <label for="spcCalcIn">Height (in)</label>
                <input type="number" id="spcCalcIn" data-calc="in" min="0" max="11" inputmode="numeric" placeholder="10">
              </div>
              <div class="spc-calc-field">
                <label for="spcCalcInseam">Inseam (in)</label>
                <input type="number" id="spcCalcInseam" data-calc="inseam" min="20" max="40" inputmode="numeric" placeholder="32">
              </div>
              <div class="spc-calc-field" style="justify-content:flex-end">
                <button type="submit" class="spc-btn spc-btn--ghost-dark" style="padding-block:12px">Calculate size</button>
              </div>
            </div>
          </form>
          <div class="spc-calc-result" role="status" aria-live="polite">
            <div class="spc-calc-result__size">Recommended size: <b data-calc-size>M</b></div>
            <div class="spc-calc-result__note">{{ section.settings.calc_note }}</div>
          </div>
        </div>
        <div class="spc-sizing-card spc-sizing-card--quiz spc-reveal d1">
          <span class="spc-sizing-eyebrow">{{ section.settings.quiz_eyebrow }}</span>
          <h3>{{ section.settings.quiz_heading }}</h3>
          <p>{{ section.settings.quiz_body }}</p>
          <a class="spc-btn spc-btn--primary" href="{{ quiz_link }}" data-quiz="sizing">{{ section.settings.quiz_btn_label }} <span class="spc-arw">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 6 · REVIEWS + ATHLETE PROOF ===== {%- endcomment -%}
  <section class="spc-sec spc-reviews" id="spc-reviews">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.reviews_eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.reviews_heading }}</h2>
      </div>
      <div class="spc-rating spc-reveal">
        <div class="spc-rating__block">
          <span class="spc-rating__num">{{ section.settings.rating_avg }}<span class="spc-stars">★</span></span>
          <span class="spc-rating__lbl">{{ section.settings.rating_avg_label }}</span>
        </div>
        <div class="spc-rating__block">
          <span class="spc-rating__num">{{ section.settings.rating_count }}</span>
          <span class="spc-rating__lbl">{{ section.settings.rating_count_label }}</span>
        </div>
        <div class="spc-rating__block">
          <span class="spc-rating__num">{{ section.settings.rating_recommend }}</span>
          <span class="spc-rating__lbl">{{ section.settings.rating_recommend_label }}</span>
        </div>
      </div>

      <div class="spc-review-grid">
        {%- for i in (1..3) -%}
          {%- assign qk = 'review' | append: i | append: '_quote' -%}
          {%- assign nk = 'review' | append: i | append: '_name' -%}
          {%- assign sk = 'review' | append: i | append: '_sub' -%}
          {%- assign rq = section.settings[qk] -%}
          {%- if rq != blank -%}
            {%- assign delay = '' -%}
            {%- if i == 2 -%}{%- assign delay = ' d1' -%}{%- elsif i == 3 -%}{%- assign delay = ' d2' -%}{%- endif -%}
            <article class="spc-review-card spc-reveal{{ delay }}">
              <div class="spc-review-card__stars">★★★★★</div>
              <p class="spc-review-card__quote">{{ rq }}</p>
              <div class="spc-review-card__meta">
                <div>
                  <div class="spc-review-card__name">{{ section.settings[nk] }}</div>
                  <div class="spc-review-card__sub">{{ section.settings[sk] }}</div>
                </div>
                <span class="spc-review-card__verified"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>Verified</span>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="spc-athlete-rule spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.athlete_eyebrow }}</p>
      </div>
      <div class="spc-proof">
        {%- for i in (1..3) -%}
          {%- assign imk = 'ath' | append: i | append: '_image' -%}
          {%- assign qk = 'ath' | append: i | append: '_quote' -%}
          {%- assign nk = 'ath' | append: i | append: '_name' -%}
          {%- assign rk = 'ath' | append: i | append: '_race' -%}
          {%- assign img = section.settings[imk] -%}
          {%- assign delay = '' -%}
          {%- if i == 2 -%}{%- assign delay = ' d1' -%}{%- elsif i == 3 -%}{%- assign delay = ' d2' -%}{%- endif -%}
          <article class="spc-proof-card spc-reveal{{ delay }}">
            <div class="spc-proof-card__photo{% unless img %} spc-ph spc-ph--light{% endunless %}"{% if img %} style="background-image:url({{ img | image_url: width: 900 }})"{% else %} data-label="Athlete photo"{% endif %}></div>
            <div class="spc-proof-card__body">
              <p class="spc-proof-card__quote">{{ section.settings[qk] }}</p>
              <div>
                <div class="spc-proof-card__name">{{ section.settings[nk] }}</div>
                <div class="spc-proof-card__race">{{ section.settings[rk] }}</div>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 7 · FAQ ===== {%- endcomment -%}
  <section class="spc-sec spc-faq">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.faq_eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.faq_heading }}</h2>
      </div>
      <div class="spc-faq-list spc-reveal">
        {%- for i in (1..7) -%}
          {%- assign qk = 'faq_q' | append: i -%}
          {%- assign ak = 'faq_a' | append: i -%}
          {%- assign q = section.settings[qk] -%}
          {%- if q != blank -%}
            <div class="spc-faq-item">
              <button class="spc-faq-q" aria-expanded="false">{{ q }}<span class="spc-faq-q__icon" aria-hidden="true"></span></button>
              <div class="spc-faq-a"><div class="spc-faq-a__inner">{{ section.settings[ak] }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== 8 · FINAL CTA ===== {%- endcomment -%}
  <section class="spc-sec spc-final">
    <div class="spc-wrap">
      <div class="spc-final-card spc-reveal">
        <div class="spc-final-card__media{% unless section.settings.final_image %} spc-ph{% endunless %}"{% if section.settings.final_image %} style="background-image:url({{ section.settings.final_image | image_url: width: 2000 }})"{% else %} data-label="Final CTA — race finish / podium (different from hero)"{% endif %}></div>
        <div class="spc-final-card__scrim"></div>
        <div class="spc-final-card__inner">
          <h2>{{ section.settings.final_heading }}</h2>
          <div class="spc-final-card__cta">
            <a class="spc-btn spc-btn--primary" href="{{ final1_link }}" data-final="all">{{ section.settings.final_cta1_label }} <span class="spc-arw">→</span></a>
            <a class="spc-btn spc-btn--ghost-light" href="{{ final2_link }}" data-final="quiz">{{ section.settings.final_cta2_label }}</a>
          </div>
          <p class="spc-final-card__contact">{{ section.settings.final_contact }}</p>
        </div>
      </div>
    </div>
  </section>

</div>

{% raw %}
<script>
(function () {
  var root = document.querySelector('.spc');
  if (!root) return;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) root.classList.add('spc-anim');

  /* ---- GA4 / dataLayer event helper ---- */
  window.dataLayer = window.dataLayer || [];
  var pageLoad = (window.performance && performance.now) ? performance.now() : Date.now();
  var decisionFired = false;
  function track(name, params) {
    window.dataLayer.push(Object.assign({ event: name }, params || {}));
  }
  track('view_sp_compare');

  /* ---- scroll reveal ---- */
  var reveals = [].slice.call(root.querySelectorAll('.spc-reveal'));
  function checkReveals() {
    var vh = window.innerHeight || document.documentElement.clientHeight;
    for (var i = reveals.length - 1; i >= 0; i--) {
      var r = reveals[i].getBoundingClientRect();
      if (r.top < vh * 0.92 && r.bottom > 0) {
        reveals[i].classList.add('is-in');
        reveals.splice(i, 1);
      }
    }
  }
  checkReveals();
  window.addEventListener('scroll', checkReveals, { passive: true });
  window.addEventListener('resize', checkReveals);
  window.addEventListener('load', checkReveals);
  setTimeout(checkReveals, 300);

  /* ---- decision filter ---- */
  var pills = [].slice.call(root.querySelectorAll('.spc-pill'));
  var cols = [].slice.call(root.querySelectorAll('.spc-col'));
  var cue = root.querySelector('.spc-cue');
  var grid = root.querySelector('.spc-grid');
  var compare = document.getElementById('spc-compare');
  var STORE_KEY = 'sp_compare_filter';

  function applyFilter(filter, target, opts) {
    opts = opts || {};
    cols.forEach(function (c) { c.classList.remove('is-rec'); });
    pills.forEach(function (p) { p.setAttribute('aria-pressed', p.getAttribute('data-filter') === filter ? 'true' : 'false'); });

    var col = (target == null) ? null : cols[target];
    if (!col) {
      if (cue) { cue.classList.remove('show'); cue.innerHTML = ''; }
      return;
    }
    col.classList.add('is-rec');
    if (cue) {
      var name = col.getAttribute('data-name') || 'this build';
      cue.innerHTML = 'Based on your priority, we recommend <b>' + name + '</b>. Compare for yourself below.';
      cue.classList.add('show');
    }
    if (opts.scroll && compare) {
      var top = compare.getBoundingClientRect().top + window.scrollY - 70;
      window.scrollTo({ top: top, behavior: reduce ? 'auto' : 'smooth' });
      if (window.matchMedia('(max-width: 880px)').matches && grid) {
        setTimeout(function () {
          var left = col.offsetLeft - (grid.clientWidth - col.clientWidth) / 2;
          grid.scrollTo({ left: left, behavior: reduce ? 'auto' : 'smooth' });
        }, 450);
      }
    }
  }

  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      var filter = pill.getAttribute('data-filter');
      var target = parseInt(pill.getAttribute('data-target'), 10);
      if (pill.getAttribute('aria-pressed') === 'true') {
        try { sessionStorage.removeItem(STORE_KEY); } catch (e) {}
        applyFilter(null, null);
        return;
      }
      try { sessionStorage.setItem(STORE_KEY, JSON.stringify({ filter: filter, target: target })); } catch (e) {}
      applyFilter(filter, target, { scroll: true });
      track('select_sp_filter', { filter: filter });
    });
  });

  try {
    var saved = JSON.parse(sessionStorage.getItem(STORE_KEY) || 'null');
    if (saved && typeof saved.target === 'number') applyFilter(saved.filter, saved.target);
  } catch (e) {}

  /* ---- build CTA + view tracking ---- */
  root.querySelectorAll('[data-build-cta]').forEach(function (a) {
    a.addEventListener('click', function () {
      track('select_sp_build', { build: a.getAttribute('data-build-cta') });
      if (!decisionFired) {
        decisionFired = true;
        var now = (window.performance && performance.now) ? performance.now() : Date.now();
        track('engagement_time_to_decision', { seconds: Math.round((now - pageLoad) / 1000) });
      }
    });
  });

  if ('IntersectionObserver' in window) {
    var seen = {};
    var colObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var name = en.target.getAttribute('data-build');
        if (en.isIntersecting && en.intersectionRatio > 0.6 && !seen[name]) {
          seen[name] = true;
          track('view_build_column', { build: name });
        }
      });
    }, { threshold: [0.6] });
    cols.forEach(function (c) { colObs.observe(c); });

    var reviews = document.getElementById('spc-reviews');
    if (reviews) {
      var aovObs = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (en) { if (en.isIntersecting) { track('view_aov_proof'); obs.disconnect(); } });
      }, { threshold: 0.25 });
      aovObs.observe(reviews);
    }
  }

  /* ---- financing / quiz / final links ---- */
  root.querySelectorAll('[data-financing]').forEach(function (a) {
    a.addEventListener('click', function () { track('select_financing', { provider: a.getAttribute('data-financing') }); });
  });
  root.querySelectorAll('[data-quiz]').forEach(function (a) {
    a.addEventListener('click', function () { track('start_size_quiz', { source: a.getAttribute('data-quiz') }); });
  });
  root.querySelectorAll('[data-final]').forEach(function (a) {
    a.addEventListener('click', function () { track('click_final_cta', { target: a.getAttribute('data-final') }); });
  });

  /* ---- size calculator ---- */
  var calc = root.querySelector('.spc-calc');
  if (calc) {
    var engaged = false;
    var result = root.querySelector('.spc-calc-result');
    var sizeOut = root.querySelector('[data-calc-size]');
    calc.addEventListener('input', function () {
      if (!engaged) { engaged = true; track('engage_size_tool'); }
    });
    calc.addEventListener('submit', function (e) {
      e.preventDefault();
      var ft = parseFloat((root.querySelector('[data-calc="ft"]') || {}).value) || 0;
      var inch = parseFloat((root.querySelector('[data-calc="in"]') || {}).value) || 0;
      var inseam = parseFloat((root.querySelector('[data-calc="inseam"]') || {}).value) || 0;
      var totalIn = ft * 12 + inch;
      if (totalIn < 48 || totalIn > 90) {
        var ftEl = root.querySelector('[data-calc="ft"]');
        if (ftEl) ftEl.focus();
        return;
      }
      var size;
      if (totalIn < 64) size = 'XS';
      else if (totalIn < 67) size = 'S';
      else if (totalIn < 70) size = 'M';
      else if (totalIn < 73.5) size = 'L';
      else size = 'XL';
      if (inseam && size === 'M' && inseam < 30) size = 'S';
      if (inseam && size === 'L' && inseam > 35) size = 'XL';
      if (sizeOut) sizeOut.textContent = size;
      if (result) result.classList.add('show');
    });
  }

  /* ---- FAQ accordion ---- */
  var faqItems = [].slice.call(root.querySelectorAll('.spc-faq-item'));
  faqItems.forEach(function (item, idx) {
    var btn = item.querySelector('.spc-faq-q');
    var panel = item.querySelector('.spc-faq-a');
    if (!btn || !panel) return;
    btn.addEventListener('click', function () {
      if (item.classList.contains('open')) {
        item.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        panel.style.maxHeight = '0px';
      } else {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        panel.style.maxHeight = panel.scrollHeight + 'px';
        track('expand_faq', { question: idx + 1 });
      }
    });
  });
  window.addEventListener('resize', function () {
    faqItems.forEach(function (item) {
      if (item.classList.contains('open')) {
        var p = item.querySelector('.spc-faq-a');
        if (p) p.style.maxHeight = p.scrollHeight + 'px';
      }
    });
  });
})();
</script>
{% endraw %}

{% schema %}
{
  "name": "Compare the SP",
  "class": "sp-compare-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (premium SP, action shot — this is the LCP image)" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow (a red period is added automatically)", "default": "Choose your build" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Which SP is right for you?" },
    { "type": "inline_richtext", "id": "hero_sub", "label": "Subhead", "default": "Same race-tested carbon frame. Same <strong>SAGS</strong> adjustability. Four ways to ride it." },

    { "type": "header", "content": "Trust strip" },
    { "type": "inline_richtext", "id": "trust1", "label": "Item 1", "default": "<strong>5× winner</strong> — Triathlete Magazine \"Best Beginner Tri Bike\"" },
    { "type": "inline_richtext", "id": "trust2", "label": "Item 2", "default": "Designed by <strong>Kevin Quan</strong>, former Cervélo P-Series engineer" },
    { "type": "inline_richtext", "id": "trust3", "label": "Item 3", "default": "<strong>Lifetime frame warranty</strong> + free crash replacement" },
    { "type": "inline_richtext", "id": "trust4", "label": "Item 4", "default": "<strong>7-day home demo</strong> — pay only if you keep it" },

    { "type": "header", "content": "1 · Decision filter" },
    { "type": "text", "id": "filter_eyebrow", "label": "Eyebrow", "default": "Start here" },
    { "type": "text", "id": "filter_heading", "label": "Heading", "default": "What matters most to you?" },
    { "type": "textarea", "id": "filter_lede", "label": "Lede", "default": "Pick one and we'll point you to a build — but every option stays on the table. This is a nudge, not a quiz." },
    { "type": "text", "id": "pill1_kicker", "label": "Pill 1 — kicker (→ build 1)", "default": "Best price" },
    { "type": "text", "id": "pill1_label", "label": "Pill 1 — label", "default": "Get racing for less" },
    { "type": "text", "id": "pill1_build", "label": "Pill 1 — sub-line", "default": "Points to the SP 105" },
    { "type": "text", "id": "pill2_kicker", "label": "Pill 2 — kicker (→ build 3)", "default": "Performance for the money" },
    { "type": "text", "id": "pill2_label", "label": "Pill 2 — label", "default": "The sweet spot" },
    { "type": "text", "id": "pill2_build", "label": "Pill 2 — sub-line", "default": "Points to the SP Force AXS" },
    { "type": "text", "id": "pill3_kicker", "label": "Pill 3 — kicker (→ build 4)", "default": "Best of everything" },
    { "type": "text", "id": "pill3_label", "label": "Pill 3 — label", "default": "No compromises" },
    { "type": "text", "id": "pill3_build", "label": "Pill 3 — sub-line", "default": "Points to the SP Red AXS" },

    { "type": "header", "content": "2 · Comparison table" },
    { "type": "text", "id": "compare_eyebrow", "label": "Eyebrow", "default": "The lineup" },
    { "type": "text", "id": "compare_heading", "label": "Heading", "default": "Compare the builds" },

    { "type": "header", "content": "Build 1 — column A" },
    { "type": "image_picker", "id": "build1_image", "label": "Image" },
    { "type": "text", "id": "build1_name", "label": "Name", "default": "SP — Shimano 105" },
    { "type": "text", "id": "build1_short", "label": "Short name (CTA: \"Shop the SP __\")", "default": "105" },
    { "type": "text", "id": "build1_pos", "label": "Positioning line", "default": "For your first carbon tri bike" },
