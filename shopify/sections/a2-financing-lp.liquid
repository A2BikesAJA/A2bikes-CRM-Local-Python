{%- comment -%}
  A2 Bikes — Financing + HSA/FSA affordability landing page (Page 3)
  ----------------------------------------------------------------------------
  Lands Klaviyo abandoned-cart/browse traffic. Attacks sticker shock: leads with
  "$X/mo" and "pre-tax dollars", not the full price. Truemed (HSA/FSA) is the
  hero of the page. Includes an illustrative, no-network cost-example widget;
  all rates live in settings (see a2-cost-example.js).
{%- endcomment -%}

{{ 'a2-lp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'a2-lp.js' | asset_url }}" defer></script>
<script src="{{ 'a2-cost-example.js' | asset_url }}" defer></script>

{%- liquid
  assign cta_event = 'financing_lp_cta_click'
  assign email_event = 'financing_lp_email_capture'

  assign primary_href = section.settings.build_selector_url
  if primary_href == blank
    assign primary_href = '/collections/sp'
  endif

  assign affirm_steps = section.blocks | where: 'type', 'step'
  assign price_options = section.blocks | where: 'type', 'price_option'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}

{%- if section.settings.use_theme_fonts -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .a2-lp {
      --a2-font-display: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --a2-font-body: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    }
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {{ section.settings.body_font | font_face: font_display: 'swap' }}
  {%- endstyle -%}
{%- endif -%}

<section class="a2-lp a2-theme-financing" id="a2-financing-lp" aria-label="{{ section.settings.heading | escape }}">

  {%- comment -%} HERO {%- endcomment -%}
  <header class="a2-hero a2-section a2-hero--plain">
    <div class="a2-wrap">
      <div class="a2-hero__inner">
        {%- if section.settings.eyebrow != blank -%}<p class="a2-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="a2-h1">{{ section.settings.heading | default: 'Ride now, pay monthly — or use pre-tax dollars.' }}</h1>
        {%- if section.settings.subheading != blank -%}<p class="a2-lead">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- if section.settings.hero_example != blank -%}<p class="a2-hero__price">{{ section.settings.hero_example }}</p>{%- endif -%}
        <div class="a2-cta-row">
          {% render 'a2-cta', label: section.settings.cta_label, href: '#a2-fin-calc', event: cta_event, cta_id: 'hero-see-options' %}
          {% render 'a2-cta', label: section.settings.cta_secondary_label, href: primary_href, style: 'secondary', event: cta_event, cta_id: 'hero-build' %}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} AFFIRM + TRUEMED EXPLAINERS {%- endcomment -%}
  <div class="a2-section a2-wrap" id="a2-fin-how">
    <div class="a2-fin-grid">

      {%- comment -%} Affirm {%- endcomment -%}
      <div class="a2-card">
        <span class="a2-band__badge">Pay monthly · Affirm</span>
        <h2 class="a2-h2">{{ section.settings.affirm_heading | default: 'How paying monthly works' }}</h2>
        {%- if section.settings.affirm_text != blank -%}<p>{{ section.settings.affirm_text }}</p>{%- endif -%}
        {%- comment -%} `where` filters top-level props, not nested settings, so group is checked in-loop. {%- endcomment -%}
        {%- assign affirm_n = 0 -%}
        {%- for b in affirm_steps -%}{% if b.settings.group == 'affirm' %}{% assign affirm_n = affirm_n | plus: 1 %}{% endif %}{%- endfor -%}
        {%- if affirm_n > 0 -%}
          <ol class="a2-steps" style="margin-top:16px">
            {%- assign affirm_i = 0 -%}
            {%- for b in affirm_steps -%}
              {%- if b.settings.group == 'affirm' -%}
                {%- assign affirm_i = affirm_i | plus: 1 -%}
                <li {{ b.shopify_attributes }}><span class="a2-steps__n">{{ affirm_i }}</span><span>{{ b.settings.text }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if section.settings.financing_price > 0 -%}
          <p class="affirm-as-low-as" data-page-type="category" data-amount="{{ section.settings.financing_price | times: 100 | floor }}" style="margin-top:16px">
            {{ section.settings.affirm_example | default: 'See your estimated monthly payment at checkout.' }}
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} Truemed — hero of the page {%- endcomment -%}
      <div class="a2-card">
        <span class="a2-band__badge">Pre-tax · HSA / FSA</span>
        <h2 class="a2-h2">{{ section.settings.truemed_heading | default: 'Buy your bike with pre-tax dollars' }}</h2>
        {%- if section.settings.truemed_text != blank -%}<p>{{ section.settings.truemed_text }}</p>{%- endif -%}
        {%- assign truemed_n = 0 -%}
        {%- for b in affirm_steps -%}{% if b.settings.group == 'truemed' %}{% assign truemed_n = truemed_n | plus: 1 %}{% endif %}{%- endfor -%}
        {%- if truemed_n > 0 -%}
          <ol class="a2-steps" style="margin-top:16px">
            {%- assign truemed_i = 0 -%}
            {%- for b in affirm_steps -%}
              {%- if b.settings.group == 'truemed' -%}
                {%- assign truemed_i = truemed_i | plus: 1 -%}
                <li {{ b.shopify_attributes }}><span class="a2-steps__n">{{ truemed_i }}</span><span>{{ b.settings.text }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if section.settings.truemed_url != blank -%}
          <div style="margin-top:18px">
            {% render 'a2-cta', label: section.settings.truemed_cta_label, href: section.settings.truemed_url, event: 'truemed_learn_more', cta_id: 'financing-truemed', target: '_blank' %}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- comment -%} COMBINED COST EXAMPLE (illustrative widget) {%- endcomment -%}
  <div class="a2-band" id="a2-fin-calc">
    <div class="a2-wrap a2-section">
      <h2 class="a2-h2 a2-center">{{ section.settings.calc_heading | default: 'What could it cost you?' }}</h2>
      {%- if section.settings.calc_subheading != blank -%}<p class="a2-lead a2-center">{{ section.settings.calc_subheading }}</p>{%- endif -%}
      <div class="a2-card" style="max-width:560px;margin:24px auto 0">
        <div class="a2-calc"
             data-a2-calc
             data-apr="{{ section.settings.calc_apr }}"
             data-term="{{ section.settings.calc_term }}"
             data-tax-rate="{{ section.settings.calc_tax_rate }}">
          <div>
            <label for="a2-calc-price-{{ section.id }}">Choose a build</label>
            <select id="a2-calc-price-{{ section.id }}" data-a2-calc-price>
              {%- for b in price_options -%}
                <option value="{{ b.settings.amount }}" {{ b.shopify_attributes }}>{{ b.settings.label }}</option>
              {%- endfor -%}
            </select>
          </div>
          <div class="a2-calc__out">
            <div class="a2-calc__tile">
              <div class="a2-calc__big" data-a2-calc-monthly>—</div>
              <div class="a2-fineprint">est. monthly · Affirm</div>
            </div>
            <div class="a2-calc__tile">
              <div class="a2-calc__big" data-a2-calc-pretax>—</div>
              <div class="a2-fineprint">est. cost after pre-tax · HSA/FSA</div>
            </div>
          </div>
          <p class="a2-fineprint">{{ section.settings.calc_disclaimer | default: 'Illustrative estimates only — not an offer of credit, a quote, or tax advice. Monthly figure assumes a representative APR and term; pre-tax figure assumes an example combined tax rate. Your actual terms, eligibility and savings will differ.' }}</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} REASSURANCE / FAQ {%- endcomment -%}
  {%- if faqs.size > 0 -%}
    <div class="a2-section a2-wrap">
      <h2 class="a2-h2 a2-center">{{ section.settings.faq_heading | default: 'Good questions, answered' }}</h2>
      <div class="a2-faq" style="max-width:760px;margin:24px auto 0">
        {%- for b in faqs -%}
          <details {{ b.shopify_attributes }}>
            <summary>{{ b.settings.question }}</summary>
            <div class="a2-stack" style="padding-bottom:14px">{{ b.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} CTA INTO BUILD SELECTOR {%- endcomment -%}
  <div class="a2-section a2-wrap a2-final">
    <h2 class="a2-h2">{{ section.settings.final_heading | default: 'Find the build that fits your budget' }}</h2>
    {%- if section.settings.final_text != blank -%}<p class="a2-lead">{{ section.settings.final_text }}</p>{%- endif -%}
    <div class="a2-cta-row">
      {% render 'a2-cta', label: section.settings.final_cta_label, href: primary_href, event: cta_event, cta_id: 'final-primary' %}
    </div>
  </div>

  {%- comment -%} EMAIL CAPTURE {%- endcomment -%}
  <div class="a2-section a2-wrap">
    {% render 'a2-email-capture',
       heading: section.settings.email_heading,
       text: section.settings.email_text,
       cta_label: section.settings.email_cta_label,
       success_text: section.settings.email_success,
       company_id: section.settings.klaviyo_company_id,
       list_id: section.settings.klaviyo_list_id,
       event: email_event,
       source: section.settings.email_source,
       uid: section.id %}
  </div>

</section>

{% schema %}
{
  "name": "A2 Financing LP",
  "tag": "section",
  "class": "a2-lp-section",
  "settings": [
    { "type": "header", "content": "Fonts" },
    { "type": "checkbox", "id": "use_theme_fonts", "label": "Use custom fonts below", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Affordability" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Ride now, pay monthly — or use pre-tax dollars." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A carbon A2 is more attainable than the sticker suggests. Here's how riders actually pay for one." },
    { "type": "text", "id": "hero_example", "label": "Example monthly figure", "default": "SPs from about $63/mo with Affirm." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "See your options" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary CTA label", "default": "Browse builds" },

    { "type": "header", "content": "Routing" },
    { "type": "url", "id": "build_selector_url", "label": "Build-selector URL", "info": "Blank falls back to /collections/sp." },

    { "type": "header", "content": "Affirm explainer", "info": "Add 'Step' blocks with group = Affirm." },
    { "type": "text", "id": "affirm_heading", "label": "Heading", "default": "How paying monthly works" },
    { "type": "textarea", "id": "affirm_text", "label": "Intro text", "default": "Affirm splits your purchase into predictable monthly payments. Choose your terms at checkout — no surprises." },
    { "type": "number", "id": "financing_price", "label": "Representative price ($) for Affirm estimate", "default": 4100 },
    { "type": "text", "id": "affirm_example", "label": "Affirm fallback text", "default": "See your estimated monthly payment at checkout." },

    { "type": "header", "content": "Truemed HSA/FSA explainer (hero of page)", "info": "Add 'Step' blocks with group = Truemed." },
    { "type": "text", "id": "truemed_heading", "label": "Heading", "default": "Buy your bike with pre-tax dollars" },
    { "type": "textarea", "id": "truemed_text", "label": "Text", "default": "With a Letter of Medical Necessity through Truemed, an eligible bike can be purchased with HSA/FSA funds — using pre-tax money is effectively a discount of roughly 30%." },
    { "type": "url", "id": "truemed_url", "label": "Truemed flow URL" },
    { "type": "text", "id": "truemed_cta_label", "label": "Truemed button label", "default": "See if you qualify" },

    { "type": "header", "content": "Cost example widget (illustrative)", "info": "APR and tax rate are DECIMALS (0.15 = 15%). Add 'Price option' blocks for the dropdown." },
    { "type": "text", "id": "calc_heading", "label": "Heading", "default": "What could it cost you?" },
    { "type": "text", "id": "calc_subheading", "label": "Subheading", "default": "Pick a build to see an illustrative monthly payment and pre-tax cost." },
    { "type": "text", "id": "calc_apr", "label": "Assumed APR (decimal)", "default": "0.15" },
    { "type": "range", "id": "calc_term", "label": "Assumed term (months)", "min": 6, "max": 60, "step": 6, "default": 36, "unit": "mo" },
    { "type": "text", "id": "calc_tax_rate", "label": "Assumed pre-tax savings rate (decimal)", "default": "0.30" },
    { "type": "textarea", "id": "calc_disclaimer", "label": "Disclaimer", "default": "Illustrative estimates only — not an offer of credit, a quote, or tax advice. Your actual terms, eligibility and savings will differ." },

    { "type": "header", "content": "Reassurance / FAQ", "info": "Add 'FAQ' blocks." },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Good questions, answered" },

    { "type": "header", "content": "CTA into build selector" },
    { "type": "text", "id": "final_heading", "label": "Heading", "default": "Find the build that fits your budget" },
    { "type": "textarea", "id": "final_text", "label": "Text", "default": "Four groupsets, four price points. Pick yours and see the monthly or pre-tax number." },
    { "type": "text", "id": "final_cta_label", "label": "Button label", "default": "Build your bike" },

    { "type": "header", "content": "Email capture (Klaviyo)" },
    { "type": "text", "id": "email_heading", "label": "Heading", "default": "Want the numbers in writing?" },
    { "type": "textarea", "id": "email_text", "label": "Text", "default": "We'll send a plain-English financing + HSA/FSA breakdown you can come back to." },
    { "type": "text", "id": "email_cta_label", "label": "Button label", "default": "Email me the breakdown" },
    { "type": "text", "id": "email_success", "label": "Success message", "default": "Sent — check your inbox." },
    { "type": "text", "id": "email_source", "label": "Klaviyo custom_source", "default": "Financing LP" },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public API key (company id)", "default": "KLAVIYO_COMPANY_ID" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list id", "default": "KLAVIYO_LIST_ID" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "select", "id": "group", "label": "Group", "options": [
          { "value": "affirm", "label": "Affirm" },
          { "value": "truemed", "label": "Truemed" }
        ], "default": "affirm" },
        { "type": "text", "id": "text", "label": "Step text", "default": "Choose your build and add to cart." }
      ]
    },
    {
      "type": "price_option",
      "name": "Price option",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "SP — Shimano 105 ($3,115)" },
        { "type": "text", "id": "amount", "label": "Amount (number only, no $ or commas)", "default": "3115" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I really use my HSA/FSA on a bike?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>In many cases, yes. Truemed evaluates eligibility and, where appropriate, issues a Letter of Medical Necessity so you can use pre-tax funds. Eligibility is individual — Truemed confirms it.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "A2 Financing LP",
      "blocks": [
        { "type": "step", "settings": { "group": "affirm", "text": "Choose your build and add it to your cart." } },
        { "type": "step", "settings": { "group": "affirm", "text": "Pick Affirm at checkout and select your monthly terms." } },
        { "type": "step", "settings": { "group": "affirm", "text": "Get a quick decision and ride now, pay over time." } },
        { "type": "step", "settings": { "group": "truemed", "text": "Start the quick Truemed eligibility check." } },
        { "type": "step", "settings": { "group": "truemed", "text": "If eligible, receive a Letter of Medical Necessity." } },
        { "type": "step", "settings": { "group": "truemed", "text": "Pay with your HSA/FSA card or reimburse yourself pre-tax." } },
        { "type": "price_option", "settings": { "label": "SP — Shimano 105 ($3,115)", "amount": "3115" } },
        { "type": "price_option", "settings": { "label": "SP — SRAM Rival AXS ($4,999)", "amount": "4999" } },
        { "type": "price_option", "settings": { "label": "SP — SRAM Force AXS ($7,199)", "amount": "7199" } },
        { "type": "price_option", "settings": { "label": "SP — SRAM Red AXS ($8,999)", "amount": "8999" } },
        { "type": "faq", "settings": {} },
        { "type": "faq", "settings": { "question": "What happens at checkout?", "answer": "<p>Choose Affirm to pay monthly, or use your HSA/FSA card after completing Truemed's eligibility step. Standard returns still apply.</p>" } },
        { "type": "faq", "settings": { "question": "Is the monthly estimate a quote?", "answer": "<p>No. On-page figures are illustrative. Your real rate and terms come from Affirm at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
