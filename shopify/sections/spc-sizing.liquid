{% render 'spc-assets' %}
<div class="spc">
  <section class="spc-sec spc-sizing">
    <div class="spc-wrap">
      <div class="spc-head spc-head--center spc-reveal">
        <p class="spc-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="spc-h2">{{ section.settings.heading }}</h2>
      </div>
      <div class="spc-sizing-grid">
        <div class="spc-sizing-card spc-sizing-card--calc spc-reveal">
          <span class="spc-sizing-eyebrow">{{ section.settings.calc_eyebrow }}</span>
          <h3>{{ section.settings.calc_heading }}</h3>
          <p>{{ section.settings.calc_body }}</p>
          <form class="spc-calc" novalidate>
            <div class="spc-calc-fields">
              <div class="spc-calc-field">
                <label for="spcCalcFt">Height (ft)</label>
                <input type="number" id="spcCalcFt" data-calc="ft" min="4" max="7" inputmode="numeric" placeholder="5">
              </div>
              <div class="spc-calc-field">
                <label for="spcCalcIn">Height (in)</label>
                <input type="number" id="spcCalcIn" data-calc="in" min="0" max="11" inputmode="numeric" placeholder="10">
              </div>
              <div class="spc-calc-field">
                <label for="spcCalcInseam">Inseam (in)</label>
                <input type="number" id="spcCalcInseam" data-calc="inseam" min="20" max="40" inputmode="numeric" placeholder="32">
              </div>
              <div class="spc-calc-field" style="justify-content:flex-end">
                <button type="submit" class="spc-btn spc-btn--ghost-dark" style="padding-block:12px">Calculate size</button>
              </div>
            </div>
          </form>
          <div class="spc-calc-result" role="status" aria-live="polite">
            <div class="spc-calc-result__size">Recommended size: <b data-calc-size>M</b></div>
            <div class="spc-calc-result__note">{{ section.settings.calc_note }}</div>
          </div>
        </div>
        <div class="spc-sizing-card spc-sizing-card--quiz spc-reveal d1">
          <span class="spc-sizing-eyebrow">{{ section.settings.quiz_eyebrow }}</span>
          <h3>{{ section.settings.quiz_heading }}</h3>
          <p>{{ section.settings.quiz_body }}</p>
          <a class="spc-btn spc-btn--primary" href="{{ section.settings.quiz_link | default: '/pages/bike-selector' }}" data-quiz="sizing">{{ section.settings.quiz_btn_label }} <span class="spc-arw">→</span></a>
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "SP · Sizing",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get the fit right" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which size you need?" },
    { "type": "text", "id": "calc_eyebrow", "label": "Calculator — eyebrow", "default": "Quick sizing tool" },
    { "type": "text", "id": "calc_heading", "label": "Calculator — heading", "default": "Find your frame size" },
    { "type": "textarea", "id": "calc_body", "label": "Calculator — body", "default": "Enter your height and inseam — we'll recommend an SP frame size in seconds." },
    { "type": "text", "id": "calc_note", "label": "Calculator — result note", "default": "We offer free size exchanges if it's not right when it arrives." },
    { "type": "text", "id": "quiz_eyebrow", "label": "Quiz — eyebrow", "default": "Need more help?" },
    { "type": "text", "id": "quiz_heading", "label": "Quiz — heading", "default": "Take the 90-second quiz" },
    { "type": "textarea", "id": "quiz_body", "label": "Quiz — body", "default": "Answer a few questions about your riding goals and we'll recommend the right SP build and size — not just the number, the whole decision." },
    { "type": "text", "id": "quiz_btn_label", "label": "Quiz — button label", "default": "Start the quiz" },
    { "type": "url", "id": "quiz_link", "label": "Quiz — link (defaults to /pages/bike-selector)" }
  ],
  "presets": [{ "name": "SP · Sizing" }]
}
{% endschema %}
