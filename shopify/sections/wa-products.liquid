{% render 'wa-assets' %}
<div class="whya2">
  <section class="wa-sec wa-sec--paper">
    <div class="wa-wrap">
      <div class="wa-head reveal">
        <p class="wa-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="wa-h2">{{ section.settings.heading }}</h2>
        <p class="wa-lede">{{ section.settings.lede }}</p>
      </div>
      <div class="wa-prod">
        {%- for block in section.blocks -%}
          {%- assign dly = forloop.index0 | at_most: 3 -%}
          <a class="wa-prod-card reveal{% if dly > 0 %} d{{ dly }}{% endif %}" href="{{ block.settings.link | default: '/collections/sp' }}" {{ block.shopify_attributes }}>
            <div class="wa-prod-mediawrap">
              <div class="wa-prod-media{% unless block.settings.image %} wa-ph wa-ph--light{% endunless %}"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 1600 }})"{% else %} data-label="Product photo — set in theme editor"{% endif %}>
                <span class="wa-badge">{{ block.settings.badge }}</span>
              </div>
            </div>
            <div class="wa-prod-body">
              <div class="wa-prod-row">
                <h3>{{ block.settings.name }}</h3>
                <div class="wa-price">from <b>{{ block.settings.price }}</b></div>
              </div>
              <p>{{ block.settings.body }}</p>
              <div class="wa-arrow">Explore the {{ block.settings.name }} <span>→</span></div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Why A2 · Product range",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your A2" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Two platforms, one obsession: fast bikes that fit real riders — priced direct." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Triathlon" },
        { "type": "text", "id": "name", "label": "Name", "default": "SP" },
        { "type": "text", "id": "price", "label": "Price", "default": "$3,115" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Our triathlon and time-trial machine — superbike aerodynamics and fit, without the superbike price." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why A2 · Product range",
      "blocks": [
        { "type": "product", "settings": { "badge": "Triathlon", "name": "SP", "price": "$3,115", "body": "Our triathlon and time-trial machine — superbike aerodynamics and fit, without the superbike price.", "link": "/pages/sp" } },
        { "type": "product", "settings": { "badge": "Road & Tri", "name": "Rogue", "price": "$2,699", "body": "One bike for road and gravel — fast on pavement, capable when the pavement ends.", "link": "/pages/rogue" } }
      ]
    }
  ]
}
{% endschema %}
