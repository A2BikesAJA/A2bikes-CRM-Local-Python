{% render 'wa-assets' %}
<div class="whya2">
  <section class="wa-sec wa-sec--paper">
    <div class="wa-wrap">
      <div class="wa-head reveal">
        <p class="wa-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="wa-h2">{{ section.settings.heading }}</h2>
        <p class="wa-lede">{{ section.settings.lede }}</p>
      </div>
      <div class="wa-prod">
        {%- for block in section.blocks -%}
          {%- assign dly = forloop.index0 | at_most: 3 -%}
          {%- liquid
            assign card_product = block.settings.product
            if card_product
              assign from_price = card_product.price_min | money_without_trailing_zeros
            else
              assign from_price = block.settings.price
            endif
          -%}
          <a class="wa-prod-card reveal{% if dly > 0 %} d{{ dly }}{% endif %}" href="{{ block.settings.link | default: '/collections/sp' }}" {{ block.shopify_attributes }}>
            <div class="wa-prod-mediawrap">
              <div class="wa-prod-media{% unless block.settings.image %} wa-ph wa-ph--light{% endunless %}"{% if block.settings.image %} style="background-image:url({{ block.settings.image | image_url: width: 1600 }})"{% else %} data-label="Product photo — set in theme editor"{% endif %}>
                <span class="wa-badge">{{ block.settings.badge }}</span>
              </div>
            </div>
            <div class="wa-prod-body">
              <div class="wa-prod-row">
                <h3>{{ block.settings.name }}</h3>
                <div class="wa-price">from <b>{{ from_price }}</b></div>
              </div>
              <p>{{ block.settings.body }}</p>
              {%- if section.settings.show_financing_line and card_product -%}
                {%- liquid
                  assign fin_months = section.settings.financing_months | default: 36
                  assign fin_dollars = card_product.price_min | divided_by: 100.0 | divided_by: fin_months | ceil
                  assign fin_cents = fin_dollars | times: 100
                -%}
                <div class="wa-fin">or ~<b>{{ fin_cents | money_without_trailing_zeros }}/mo</b> {{ section.settings.financing_suffix }}</div>
              {%- endif -%}
              <div class="wa-arrow">Explore the {{ block.settings.name }} <span>→</span></div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Why A2 · Product range",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your A2" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Two platforms, one obsession: fast bikes that fit real riders — priced direct." },
    { "type": "header", "content": "Financing line (illustrative — estimate only, not a quote)" },
    { "type": "checkbox", "id": "show_financing_line", "label": "Show \"or ~$X/mo\" line on cards (needs a product set on the card)", "default": false },
    { "type": "range", "id": "financing_months", "label": "Illustrative term (months)", "min": 6, "max": 48, "step": 6, "default": 36, "info": "Used only to compute the ~$X/mo estimate. Actual financing terms vary by rider and provider." },
    { "type": "text", "id": "financing_suffix", "label": "Text after the monthly amount", "default": "with financing · HSA/FSA eligible" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Triathlon" },
        { "type": "text", "id": "name", "label": "Name", "default": "SP" },
        { "type": "product", "id": "product", "label": "Product for live \"from\" price (pick the line's entry build)" },
        { "type": "text", "id": "price", "label": "Fallback price text (used only when no product is set)", "default": "$3,115" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "Our triathlon and time-trial machine — superbike aerodynamics and fit, without the superbike price." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why A2 · Product range",
      "blocks": [
        { "type": "product", "settings": { "badge": "Triathlon", "name": "SP", "price": "$3,115", "body": "Our triathlon and time-trial machine — superbike aerodynamics and fit, without the superbike price.", "link": "/pages/sp-performance" } },
        { "type": "product", "settings": { "badge": "Road & Gravel", "name": "Rogue", "price": "$2,699", "body": "One bike for road and gravel — fast on pavement, capable when the pavement ends.", "link": "/pages/rogue-road-gravel" } }
      ]
    }
  ]
}
{% endschema %}
