{% render 'spc-assets' %}
<div class="spc">
  <section class="spc-sec spc-final">
    <div class="spc-wrap">
      <div class="spc-final-card spc-reveal">
        <div class="spc-final-card__media{% unless section.settings.image %} spc-ph{% endunless %}"{% if section.settings.image %} style="background-image:url({{ section.settings.image | image_url: width: 2000 }})"{% else %} data-label="Final CTA — race finish / podium (different from hero)"{% endif %}></div>
        <div class="spc-final-card__scrim"></div>
        <div class="spc-final-card__inner">
          <h2>{{ section.settings.heading }}</h2>
          <div class="spc-final-card__cta">
            <a class="spc-btn spc-btn--primary" href="{{ section.settings.cta1_link | default: '/collections/sp' }}" data-final="all">{{ section.settings.cta1_label }} <span class="spc-arw">→</span></a>
            <a class="spc-btn spc-btn--ghost-light" href="{{ section.settings.cta2_link | default: '/pages/bike-selector' }}" data-final="quiz">{{ section.settings.cta2_label }}</a>
          </div>
          <p class="spc-final-card__contact">{{ section.settings.contact }}</p>
        </div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "SP · Final CTA",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (race finish / podium — different from hero)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to choose your build?" },
    { "type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Shop the SP — all builds" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link (defaults to /collections/sp)" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Or take the 90-second quiz" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link (defaults to /pages/bike-selector)" },
    { "type": "inline_richtext", "id": "contact", "label": "Contact line", "default": "Questions? Email <a href=\"mailto:support@a2bikes.com\">support@a2bikes.com</a> or chat with us during business hours." }
  ],
  "presets": [{ "name": "SP · Final CTA" }]
}
{% endschema %}
