{%- comment -%}
  A2 Bikes — slim "pay over time" marketing band for collection pages.
  Generic financing language only (no dollar figures — Affirm's own
  as-low-as messaging lives on the product cards). All copy is
  settings-driven per the claims/financing discipline.
{%- endcomment -%}
<section class="a2-colfin" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};">
  <div class="a2-colfin__wrap">
    <div class="a2-colfin__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="a2-colfin__eyebrow" style="color:{{ section.settings.accent_color }};">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="a2-colfin__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="a2-colfin__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="a2-colfin__cta">
        <a
          class="a2-colfin__btn"
          style="border-color:{{ section.settings.accent_color }};color:{{ section.settings.text_color }};"
          href="{{ section.settings.button_link | default: '/pages/financing-hsa-fsa' }}"
          onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({event: 'collection_financing_click', cta_id: 'collection-financing-band'});"
        >{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>
{% stylesheet %}
.a2-colfin { padding: 28px 0; }
.a2-colfin__wrap { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px);
  display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.a2-colfin__eyebrow { margin: 0 0 6px; text-transform: uppercase; letter-spacing: .18em;
  font-size: .72rem; font-weight: 600; }
.a2-colfin__heading { margin: 0; font-size: clamp(1.2rem, 2.2vw, 1.6rem); line-height: 1.15; }
.a2-colfin__text { margin-top: 8px; font-size: .95rem; max-width: 560px; }
.a2-colfin__text p { margin: 0; }
.a2-colfin__btn { display: inline-block; padding: 12px 22px; border: 1.5px solid; border-radius: 4px;
  font-weight: 600; text-decoration: none; transition: transform .18s ease; }
.a2-colfin__btn:hover { transform: translateY(-2px); }
@media (max-width: 720px) { .a2-colfin__wrap { flex-direction: column; align-items: flex-start; } }
{% endstylesheet %}
{% schema %}
{
  "name": "A2 · Financing band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Financing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride now. Pay over time." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Split your purchase into monthly payments with Affirm, or save an average of 30% using pre-tax HSA/FSA dollars with Truemed.</p>", "info": "Keep figures generic or sourced — this copy ships on every collection using the template." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore financing options" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to /pages/financing-hsa-fsa when blank." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f7f7e8" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#222425" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C51C26" }
  ],
  "presets": [{ "name": "A2 · Financing band" }]
}
{% endschema %}
