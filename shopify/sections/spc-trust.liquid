{% render 'spc-assets' %}
<div class="spc">
  <div class="spc-trust">
    <div class="spc-wrap spc-trust__row">
      {%- for block in section.blocks -%}
        <div class="spc-trust__item" {{ block.shopify_attributes }}>
          {% render 'spc-icon', icon: block.settings.icon %}
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "SP · Trust strip",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "star", "label": "Star" },
          { "value": "clock", "label": "Clock" },
          { "value": "shield", "label": "Shield / check" },
          { "value": "home", "label": "Home" },
          { "value": "frame", "label": "Bike frame" },
          { "value": "sliders", "label": "Sliders" },
          { "value": "box", "label": "Box" }
        ], "default": "star" },
        { "type": "inline_richtext", "id": "text", "label": "Text (bold the key phrase)", "default": "<strong>5× winner</strong> — Triathlete Magazine \"Best Beginner Tri Bike\"" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SP · Trust strip",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "star", "text": "<strong>5× winner</strong> — Triathlete Magazine \"Best Beginner Tri Bike\"" } },
        { "type": "trust_item", "settings": { "icon": "clock", "text": "Designed by <strong>Kevin Quan</strong>, former Cervélo P-Series engineer" } },
        { "type": "trust_item", "settings": { "icon": "shield", "text": "<strong>Lifetime frame warranty</strong> + free crash replacement" } },
        { "type": "trust_item", "settings": { "icon": "home", "text": "<strong>7-day home demo</strong> — pay only if you keep it" } }
      ]
    }
  ]
}
{% endschema %}
