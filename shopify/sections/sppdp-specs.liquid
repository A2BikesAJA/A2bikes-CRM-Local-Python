{%- comment -%} SP-105 PDP — quick specs + accordion. First accordion group opens by default (sp-pdp.js). Drive rows from metafields where possible in production. Each accordion row is one "Label | Value" line. {%- endcomment -%}
{% render 'sppdp-assets' %}
<div class="sppdp">
  <section class="pdp-section pdp-section--paper" id="sppdp-specs">
    <div class="pdp-wrap specs">
      <div class="pdp-section__head">
        <span class="pdp-section__kicker">{{ section.settings.kicker }}</span>
        <h2 class="pdp-section__title">{{ section.settings.heading }}</h2>
      </div>

      {%- assign has_quick = false -%}
      {%- for b in section.blocks -%}{% if b.type == 'quick' %}{% assign has_quick = true %}{% endif %}{%- endfor -%}
      {%- if has_quick -%}
      <div class="spec-quick">
        {%- for b in section.blocks -%}
          {%- if b.type != 'quick' -%}{%- continue -%}{%- endif -%}
          <div class="spec-quick__item" {{ b.shopify_attributes }}><div class="spec-quick__k">{{ b.settings.k }}</div><div class="spec-quick__v">{{ b.settings.v }}</div></div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      <div class="accordion">
        {%- for b in section.blocks -%}
          {%- if b.type != 'group' -%}{%- continue -%}{%- endif -%}
          <div class="acc-item" {{ b.shopify_attributes }}>
            <button class="acc-q" aria-expanded="false">{{ b.settings.title }}<span class="acc-q__icon" aria-hidden="true"></span></button>
            <div class="acc-a"><div class="acc-a__inner"><table class="spec-table">
              {%- assign rows = b.settings.rows | strip | newline_to_br | split: '<br />' -%}
              {%- for r in rows -%}
                {%- assign rr = r | strip -%}
                {%- if rr == blank -%}{%- continue -%}{%- endif -%}
                {%- assign parts = rr | split: '|' -%}
                <tr><td>{{ parts[0] | strip }}</td><td>{{ parts[1] | strip }}</td></tr>
              {%- endfor -%}
            </table></div></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "SP-105 PDP · Specs",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Specs & details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything on the SP-105" }
  ],
  "blocks": [
    {
      "type": "quick",
      "name": "Quick-spec tile",
      "settings": [
        { "type": "text", "id": "k", "label": "Label", "default": "Frame weight" },
        { "type": "text", "id": "v", "label": "Value", "default": "1,250 g" }
      ]
    },
    {
      "type": "group",
      "name": "Accordion group",
      "settings": [
        { "type": "text", "id": "title", "label": "Group title", "default": "Frame & fork" },
        { "type": "textarea", "id": "rows", "label": "Rows (one \"Label | Value\" per line)", "default": "Material | Hand-laid Toray T700 carbon fiber\nRouting | Fully internal cable & hydraulic hose" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SP-105 PDP · Specs",
      "blocks": [
        { "type": "quick", "settings": { "k": "Frame weight", "v": "1,250 g" } },
        { "type": "quick", "settings": { "k": "Groupset", "v": "105 · 12-spd" } },
        { "type": "quick", "settings": { "k": "Wheels", "v": "Vision Team 30" } },
        { "type": "quick", "settings": { "k": "Complete weight", "v": "~9.1 kg" } },
        { "type": "group", "settings": { "title": "Frame & fork", "rows": "Material | Hand-laid Toray T700 carbon fiber\nFrame weight | 1,250 g (size M, painted)\nTube profiles | Truncated-airfoil (kammtail) down tube, seat tube & fork\nRouting | Fully internal cable & hydraulic hose\nDesigner | Kevin Quan (former Cervélo P-Series engineer)" } },
        { "type": "group", "settings": { "title": "Drivetrain", "rows": "Groupset | Shimano 105 R7100, 12-speed mechanical\nShifting | Bar-end shifters (TT/tri standard)\nCrankset | 52/36T mid-compact\nCassette | 11–34T, 12-speed\nBrakes | Shimano 105 hydraulic disc, flat-mount" } },
        { "type": "group", "settings": { "title": "Wheels & tires", "rows": "Wheelset | Vision Team 30 alloy, tubeless-ready\nTires | Continental Ultra Sport III, 700×28c\nAxles | 12mm thru-axle, front & rear\nUpgrade path | Accepts standard 12-speed wheelsets — many owners add deep aero wheels for race day" } },
        { "type": "group", "settings": { "title": "Cockpit & fit (SAGS)", "rows": "Aerobar | SAGS integrated cockpit, alloy extensions\nPad adjustment | 140mm fore/aft, 95mm stack range\nExtension shape | Ski-bend, tool-free angle adjust\nBase bar | Aero alloy, internally routed" } },
        { "type": "group", "settings": { "title": "Geometry & sizing", "rows": "Sizes | XS · S · M · L · XL\nRider range | ~5'1\" to 6'4\" (155–193 cm)\nSize M fits | ~5'7\"–5'10\"\nSizing help | Free remote fit call + size calculator; free exchanges" } },
        { "type": "group", "settings": { "title": "In the box & assembly", "rows": "Pre-assembly | Ships 92% assembled\nYou install | Seatpost, cockpit, and brake dial-in — the headset & stem are the fiddly parts, so take your time with the included torque wrench\nTypical setup time | Under an hour with the included video guide\nPrefer a shop? | Most local shops finish the build for $50–150" } }
      ]
    }
  ]
}
{% endschema %}
