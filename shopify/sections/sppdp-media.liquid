{%- comment -%}
  SP PDP — media band: hero video ("see it move") + rider UGC strip.
  Hero + clips each accept a theme-editor video pick (preferred) or a CDN
  URL fallback so marketing can wire files either way without a deploy.
  Renders nothing until at least one video is set. Plays push a GTM
  dataLayer event; no pixels here (hard rule).
{%- endcomment -%}
{% render 'sppdp-assets' %}

{%- liquid
  assign hero_src = blank
  assign hero_poster = blank
  if section.settings.hero_video != blank
    assign hero_src = section.settings.hero_video.sources | where: 'format', 'mp4' | first
    assign hero_poster = section.settings.hero_video.preview_image
  endif
  assign hero_url = section.settings.hero_url | strip
  assign clip_count = 0
  for block in section.blocks
    if block.settings.clip_video != blank or block.settings.clip_url != blank
      assign clip_count = clip_count | plus: 1
    endif
  endfor
-%}

{%- if hero_src != blank or hero_url != blank or clip_count > 0 -%}
<div class="sppdp">
  <section class="pdp-section pdp-section--paper" id="sppdp-media">
    <div class="pdp-wrap">
      <div class="pdp-section__head">
        <span class="pdp-section__kicker">{{ section.settings.kicker }}</span>
        <h2 class="pdp-section__title">{{ section.settings.heading }}</h2>
      </div>

      {%- if hero_src != blank or hero_url != blank -%}
      <div class="pdpm-hero">
        <video class="pdpm-hero__video" data-a2-video="{{ section.settings.heading | escape }} — hero"
          {% if section.settings.autoplay %}autoplay muted loop playsinline preload="metadata"{% else %}controls preload="none"{% endif %}
          {% if section.settings.hero_poster %}poster="{{ section.settings.hero_poster | image_url: width: 1600 }}"{% elsif hero_poster %}poster="{{ hero_poster | image_url: width: 1600 }}"{% endif %}>
          {%- if hero_src != blank -%}
            <source src="{{ hero_src.url }}" type="video/mp4">
          {%- else -%}
            <source src="{{ hero_url }}" type="video/mp4">
          {%- endif -%}
        </video>
        {%- if section.settings.hero_caption != blank -%}
        <p class="pdpm-hero__caption">{{ section.settings.hero_caption }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if clip_count > 0 -%}
      {%- if section.settings.strip_heading != blank -%}
      <h3 class="pdpm-strip__title">{{ section.settings.strip_heading }}</h3>
      {%- endif -%}
      <div class="pdpm-strip" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c_src = blank
            assign c_poster = blank
            if block.settings.clip_video != blank
              assign c_src = block.settings.clip_video.sources | where: 'format', 'mp4' | first
              assign c_poster = block.settings.clip_video.preview_image
            endif
            assign c_url = block.settings.clip_url | strip
          -%}
          {%- if c_src == blank and c_url == blank -%}{%- continue -%}{%- endif -%}
          <figure class="pdpm-clip" role="listitem" {{ block.shopify_attributes }}>
            <div class="pdpm-clip__frame">
              <video preload="none" playsinline data-a2-video="{{ block.settings.name | default: 'UGC clip' | escape }}"
                {% if block.settings.clip_poster %}poster="{{ block.settings.clip_poster | image_url: width: 600 }}"{% elsif c_poster %}poster="{{ c_poster | image_url: width: 600 }}"{% endif %}>
                {%- if c_src != blank -%}
                  <source src="{{ c_src.url }}" type="video/mp4">
                {%- else -%}
                  <source src="{{ c_url }}" type="video/mp4">
                {%- endif -%}
              </video>
              <button class="pdpm-clip__play" type="button" aria-label="Play video{% if block.settings.name != blank %} from {{ block.settings.name | escape }}{% endif %}">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            {%- if block.settings.name != blank or block.settings.caption != blank -%}
            <figcaption class="pdpm-clip__meta">
              {%- if block.settings.name != blank -%}<span class="pdpm-clip__name">{{ block.settings.name }}</span>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="pdpm-clip__ctx">{{ block.settings.caption }}</span>{%- endif -%}
            </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </section>
</div>

<style>
  #sppdp-media .pdpm-hero{margin:0 0 28px}
  #sppdp-media .pdpm-hero__video{display:block;width:100%;border-radius:14px;background:#0b0b0c;aspect-ratio:16/9;object-fit:cover}
  #sppdp-media .pdpm-hero__caption{margin:10px 2px 0;font-size:.85rem;opacity:.7}
  #sppdp-media .pdpm-strip__title{margin:0 0 14px;font-size:1.05rem}
  #sppdp-media .pdpm-strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(180px,220px);gap:14px;overflow-x:auto;padding-bottom:8px;-webkit-overflow-scrolling:touch;scroll-snap-type:x mandatory}
  #sppdp-media .pdpm-clip{margin:0;scroll-snap-align:start}
  #sppdp-media .pdpm-clip__frame{position:relative;border-radius:12px;overflow:hidden;background:#0b0b0c;aspect-ratio:9/16}
  #sppdp-media .pdpm-clip__frame video{width:100%;height:100%;object-fit:cover;display:block}
  #sppdp-media .pdpm-clip__play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.18);border:0;cursor:pointer;color:#fff;transition:background .15s}
  #sppdp-media .pdpm-clip__play:hover{background:rgba(0,0,0,.32)}
  #sppdp-media .pdpm-clip__play svg{width:46px;height:46px;filter:drop-shadow(0 2px 8px rgba(0,0,0,.5))}
  #sppdp-media .pdpm-clip--playing .pdpm-clip__play{display:none}
  #sppdp-media .pdpm-clip__meta{display:flex;flex-direction:column;gap:2px;margin-top:8px}
  #sppdp-media .pdpm-clip__name{font-weight:600;font-size:.9rem}
  #sppdp-media .pdpm-clip__ctx{font-size:.8rem;opacity:.7}
</style>

<script>
  (function () {
    if (window.__a2PdpMedia) return; window.__a2PdpMedia = true;
    function track(el) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'a2_video_play', video_name: el.getAttribute('data-a2-video') || 'pdp video' });
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('#sppdp-media .pdpm-clip__play');
      if (!btn) return;
      var clip = btn.closest('.pdpm-clip');
      var video = clip.querySelector('video');
      document.querySelectorAll('#sppdp-media .pdpm-clip video').forEach(function (v) {
        if (v !== video) { v.pause(); v.controls = false; v.closest('.pdpm-clip').classList.remove('pdpm-clip--playing'); }
      });
      clip.classList.add('pdpm-clip--playing');
      video.controls = true; video.muted = false; video.play(); track(video);
    });
    document.querySelectorAll('#sppdp-media .pdpm-hero__video').forEach(function (v) {
      var sent = false;
      v.addEventListener('play', function () { if (!sent) { sent = true; if (!v.autoplay) track(v); } });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SP PDP · Video & UGC",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Real rider footage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the SP in action" },
    { "type": "video", "id": "hero_video", "label": "Hero video", "info": "Pick an uploaded file. Wide format (16:9) plays best." },
    { "type": "text", "id": "hero_url", "label": "Hero URL", "info": "Fallback: paste a Shopify Files CDN .mp4 link if not using the picker." },
    { "type": "image_picker", "id": "hero_poster", "label": "Hero poster" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay hero", "info": "Muted loop, like a header animation. Off = click to play with sound.", "default": true },
    { "type": "text", "id": "hero_caption", "label": "Hero caption" },
    { "type": "text", "id": "strip_heading", "label": "Strip heading", "default": "From riders, not our studio" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Rider clip",
      "settings": [
        { "type": "video", "id": "clip_video", "label": "Clip video", "info": "Vertical (9:16) plays best." },
        { "type": "text", "id": "clip_url", "label": "Clip URL", "info": "Fallback: Shopify Files CDN .mp4 link." },
        { "type": "image_picker", "id": "clip_poster", "label": "Poster" },
        { "type": "text", "id": "name", "label": "Rider name" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "SP PDP · Video & UGC" }]
}
{% endschema %}
