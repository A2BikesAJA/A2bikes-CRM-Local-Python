{%- comment -%}
  A2 Bikes — Size Calculator section. Thin wrapper around
  snippets/a2-size-calc.liquid so the calculator can be added to any
  template from the theme editor (it ships on every bike PDP).
{%- endcomment -%}
<section class="a2-size-calc-section" id="a2-size-calc-section">
  <div class="a2-size-calc-section__wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="a2-size-calc-section__head">
        {%- if section.settings.kicker != blank -%}<span class="a2-size-calc-section__kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="a2-size-calc-section__title">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {% render 'a2-size-calc' %}
  </div>
</section>
{% stylesheet %}
.a2-size-calc-section { padding: clamp(36px, 6vw, 64px) 0; }
.a2-size-calc-section__wrap { max-width: 980px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
.a2-size-calc-section__head { text-align: center; margin-bottom: 22px; }
.a2-size-calc-section__kicker { display: block; text-transform: uppercase; letter-spacing: .14em;
  font-size: .76rem; font-weight: 600; color: #C51C26; margin-bottom: 6px; }
.a2-size-calc-section__title { margin: 0; font-size: clamp(1.4rem, 2.6vw, 2rem); }
{% endstylesheet %}
{% schema %}
{
  "name": "A2 · Size calculator",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Sizing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure which size? Find out in 30 seconds." }
  ],
  "presets": [{ "name": "A2 · Size calculator" }]
}
{% endschema %}
